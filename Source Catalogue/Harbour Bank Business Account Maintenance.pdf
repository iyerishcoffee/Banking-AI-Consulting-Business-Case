</script></event><event activity="initialize" name="event__initialize"><script contentType="application/x-javascript">
savOption.rawValue = this.rawValue;


 switch (this.rawValue) {
 	case "1":
 		//both
 		Table6.presence = "visible";
 		Table6.both.presence = "visible";
 		Table6.dtls.resAdd.presence = "visible";
 		Table6.dtls.mailAdd.presence = "visible";
 		Table6.single.presence = "hidden";
 		
 		if (Table6.single.resAdd.overseas.rawValue == "1") {
 			Table6.dtls.resAdd.foreign.presence = "visible";
 			Table6.dtls.resAdd.local.presence = "hidden";
 		} else {
 			Table6.dtls.resAdd.foreign.presence = "hidden";
 			Table6.dtls.resAdd.local.presence = "visible";
 		}
 		
		if (Table6.both.mailAdd.options.option.rawValue == "2") {
 			if (Table6.single.mailAdd.overseas.rawValue == "1") {
 				Table6.dtls.mailAdd.foreign.presence = "visible";
 				Table6.dtls.mailAdd.local.presence = "hidden";
 			} else {
 				Table6.dtls.mailAdd.foreign.presence = "hidden";
 				Table6.dtls.mailAdd.local.presence = "visible";
 			}
 		} else {
 			Table6.dtls.mailAdd.foreign.presence = "hidden";
 			Table6.dtls.mailAdd.local.presence = "hidden";
 		}
 		
		Table6.dtls.resAdd.border.presence = "visible";
 		Table6.dtls.mailAdd.border.presence = "visible";
 		
 		
 		
  		break;
 	case "2":
 		//res Address
 		Table6.presence = "visible";
 		Table6.both.presence = "hidden";
 		
 		Table6.single.presence = "visible";
 		Table6.single.resAdd.presence = "visible";
 		Table6.single.mailAdd.presence = "hidden";
 		
 		Table6.dtls.resAdd.presence = "visible";
 		Table6.dtls.mailAdd.presence = "hidden";
 		
 		if (Table6.single.resAdd.overseas.rawValue == "1") {
 			Table6.dtls.resAdd.foreign.presence = "visible";
 			Table6.dtls.resAdd.local.presence = "hidden";
 		} else {
 			Table6.dtls.resAdd.foreign.presence = "hidden";
 			Table6.dtls.resAdd.local.presence = "visible";
 		}
 		
 		
		Table6.dtls.resAdd.border.presence = "hidden";
		
 		break;
 	case "3":
 		//mail address
 		Table6.presence = "visible";
 		Table6.both.presence = "hidden";
 		
 		Table6.single.presence = "visible";
 		Table6.single.resAdd.presence = "hidden";
 		Table6.single.mailAdd.presence = "visible";
 		
 		Table6.dtls.resAdd.presence = "hidden";
 		Table6.dtls.mailAdd.presence = "visible";
 		
 		if (Table6.single.mailAdd.overseas.rawValue == "1") {
 			Table6.dtls.mailAdd.foreign.presence = "visible";
 			Table6.dtls.mailAdd.local.presence = "hidden";
 		} else {
 			Table6.dtls.mailAdd.foreign.presence = "hidden";
 			Table6.dtls.mailAdd.local.presence = "visible";
 		}
 		
 		
		Table6.dtls.mailAdd.border.presence = "hidden";	
 		break;
 	default:
 		Table6.presence = "hidden";
 		
 }
 		
</script></event><?templateDesigner expand 0?></exclGroup><draw name="lblAdd" w="44.519mm" h="4.5mm" y="0.228mm" x="4mm"><value><text>Registered Business Address*</text></value><ui><textEdit/></ui><para vAlign="middle"/><font size="8pt" typeface="Myriad Pro"/><assist><speak disable="1"/></assist><?renderCache.bounds 126196 12756 0 0 0 0 0 0?><?renderCache.textRun 28 Registered Business Address* 0 0 8378 0 0 0 "Myriad Pro" 0 0 8000 ISO-8859-1?></draw><draw name="lblAdd" w="48.968mm" h="4.5mm" y="5.228mm" x="4mm"><value><text>Mailing Address </text></value><ui><textEdit/></ui><para vAlign="middle"/><font size="8pt" typeface="Myriad Pro"/><assist><speak disable="1"/></assist><?renderCache.bounds 138807 12756 0 0 0 0 0 0?><?renderCache.textRun 16 Mailing Address  0 0 8378 0 0 0 "Myriad Pro" 0 0 8000 ISO-8859-1?></draw><field name="savOption" y="0.228mm" x="117.5mm" w="62mm" h="3mm" presence="hidden"><ui><textEdit><border><edge stroke="lowered"/></border><margin/></textEdit></ui><font typeface="Adobe Arabic"/><margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><caption reserve="25mm"><font size="8pt" typeface="Arial"/><para vAlign="middle"/><value><text>Text Field</text></value></caption><bind match="none"/></field><?templateDesigner expand 0?></subform><subform name="Table6" layout="table" columnWidths="90mm 90mm"><border><edge presence="hidden"/><corner presence="hidden"/></border><subform layout="row" name="both" x="0.002mm" y="0mm"><assist role="TR"/><subform w="89mm" name="resAdd" h="15mm" x="0.003mm" y="0mm"><bind match="none"/><draw name="lblAdd" w="47.149mm" h="4.5mm" y="0mm" x="0.001mm"><value><text>New Registered Business Address</text></value><ui><textEdit/></ui><para vAlign="middle"/><font size="8pt" typeface="Myriad Pro" weight="bold"/><assist><speak disable="1"/></assist><?renderCache.bounds 133651 12756 0 0 0 0 0 0?><?renderCache.textRun 31 New Registered Business Address 0 0 8378 0 0 0 "Myriad Pro" 1 0 8000 IS