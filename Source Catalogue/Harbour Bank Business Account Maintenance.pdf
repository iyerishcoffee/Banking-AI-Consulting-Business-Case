// this.access = "protected";
</script></event><field name="clear" w="18mm" h="4mm" relevant="-print" x="37mm" y="1.253mm"><ui><button highlight="none"/></ui><font typeface="Adobe Arabic"/><caption><value><text>Clear Signature</text></value><para vAlign="middle" hAlign="center" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt" marginLeft="0pt" marginRight="0pt"/><font size="7pt" typeface="Myriad Pro" weight="bold" baselineShift="0pt"><fill><color value="255,255,255"/></fill></font></caption><border hand="right"><edge presence="hidden"/><fill><color value="51,51,51"/></fill><corner presence="hidden" thickness="0.176mm" join="round" radius="5px"/></border><bind match="none"/><assist><speak disable="1"/></assist><validate><script contentType="application/x-javascript">
 if (ImageField1.rawValue == null || ImageField1.rawValue.length == 0 ) {
 	ImageField2.access = "protected";
 	//auditor.access = "protected";
 	//signDate.date.access = "protected";
 	this.presence = "hidden";
 	
 	overlay2.presence = "visible";
	overlay2.relevant = "-print";
 } else {
 	ImageField2.access = "open";
 	//auditor.access = "open";
 	//signDate.date.access = "open";
 	overlay2.presence = "hidden";
 	
	if (ImageField2.rawValue == null || ImageField2.rawValue.length == 0 || ImageField2.access == "protected") {
	 	this.presence = "hidden";
	 	lblSigClick2.presence = "visible";
	 	lblSigClick2.relevant = "-print";
	} else {
		var errCntName = modus_utils.checkObj( auditor, false, false);
		//var errcntDate = modus_local.validateDate( signDate.date, false, true);
		var errcntDate = modus_local.validateSignDate( signDate.date, false);
		
		if (errCntName != 0 &amp;&amp; errcntDate == 0 ) {
			var promptName = xfa.host.response("What is the Name of Authorised Signatory?","Name of Authorised Signatory","",false);
			//console.println("promptName : " + promptName );
			if (promptName == null || promptName == "") {
				//skip
			} else {
				auditor.rawValue = promptName;
				modus_utils.removeBorderColor(auditor,false);
				errCntName = 0;
			}
		}
		
		
		if (errCntName != 0 || errcntDate != 0 ) {
			ImageField2.rawValue = null;
		
			this.presence = "hidden";
 			lblSigClick1.presence = "visible";
 			lblSigClick1.relevant = "-print";
 		
			xfa.host.messageBox("Oops!\n\nPlease check that the details are correct before signing this document", "Validation Error", 1, 0);
		} else {
			if (ImageField3.rawValue == null || ImageField3.rawValue.length == 0) {
	 			this.presence = "visible";
		 		this.relevant = "-print";
		 	} else {
		 		this.presence = "hidden";
		 	}
		 	lblSigClick2.presence = "invisible";
		 	
		 	nameDate0.clear.presence = "hidden";
		 	auditor.access = "protected";
			signDate.date.access = "protected";
			ImageField2.access = "protected";
			modus_local.setCurrentDate(signDate.date);
	 	}
	 }
 }
 true;
 	
 	
</script></validate><event activity="click" name="event__click"><script contentType="application/x-javascript">		
	ImageField2.rawValue = null;
	
   	auditor.access = "open";
   	auditor.rawValue = "";
   	
   	nameDate0.clear.presence = "visible";
   	signDate.date.access = "open";
   	signDate.date.dateDD.rawValue = "";
   	signDate.date.dateMM.rawValue = "";
   	signDate.date.dateYY.rawValue = "";

	nameDate0.clear.execValidate();
	
	modus_utils.removeBorderColor(nameDate2.auditor, false)
