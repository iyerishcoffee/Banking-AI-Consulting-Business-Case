//======================================================
 function checkAccNum ( fld , mandatory) {
 	var errcnt = 0;
 	
 	if (modus_utils.is_empty(fld) &amp;&amp; !mandatory) {
 		modus_utils.removeBorderColor(fld ,false);
 		return errcnt;
 	}
 	
 	modus_utils.errMsg = "Account number is required";
 	if (modus_utils.checkObj( fld , false, false) ) {
 		errcnt++;
 	} else {
 		if ( fld.rawValue.length != 10 &amp;&amp; fld.rawValue.length != 12 ) {
 			modus_utils.errMsg = "Account number must be 10 or 12 digits";
 			modus_utils.changeBorderColorRed( fld );
 			errcnt++;
 		}
 	}
 	
	return errcnt;
}

 function checkCcardNum ( fld ) {
 	var errcnt = 0;
 	
 	modus_utils.errMsg = "Card number is required";
 	if ( modus_utils.checkObj( fld , false, false) == 1 ) {
 		errcnt++;
 	} else {
 		if ( fld.rawValue.length != 16 ) {
 			modus_utils.errMsg = "Card number must be 16 digits";
 			modus_utils.changeBorderColorRed( fld );
 			errcnt++;
 		}
 	}
 	
	return errcnt;
}


//=================================================
function getCurDate() {
			//get current date
			var cdate = new Date();
			var yyyy =  cdate.getFullYear() ;
			var mm = cdate.getMonth() + 1;
			mm = (mm &lt;= 9 ? "0" : "") + mm;
			var dd = cdate.getDate();
			dd = (dd &lt;= 9 ? "0" : "") + dd;
			return yyyy + mm + dd;
}

//=================================================
function getCurDateTime() {
			//get current date
			var cdate = new Date();
			var yyyy =  cdate.getFullYear() ;
			var mm = cdate.getMonth() + 1;
			mm = (mm &lt;= 9 ? "0" : "") + mm;
			var dd = cdate.getDate();
			dd = (dd &lt;= 9 ? "0" : "") + dd;
			
			var hr = cdate.getHours();
			hr = (hr &lt;= 9 ? "0" : "") + hr ;
			var min = cdate.getMinutes();
			min = (min &lt;= 9 ? "0" : "") + min ;
			var sec = cdate.getSeconds();
			sec = (sec &lt;= 9 ? "0" : "") + sec ;
			
			return dd + "-" + mm + "-" + yyyy + " " + hr + ":" + min + ":" + sec;
}

function checkExpDate() {
	var expiryStatus = '';
	
	var currDate = getCurDate();   //(YYYYMMDD
	//console.println("currDate : " + currDate + " expDate: " + Main.hidden.expDate.rawValue);
	
	if (Number(currDate) &gt; Number( Main.hidden.expDate.rawValue ) ) {
		expiryStatus = 'E';    //==&gt; mean expired
	} 
	
	else {
		if (Number(currDate) &gt;= Number(Main.hidden.warnDate.rawValue)) {
			expiryStatus = 'W';    //==&gt; mean warning
		}
	}
	
	return expiryStatus ;
}
//=================================================
 function checkPhone( inSf , focus, isRequired ) {
 	
	var errcnt = 0;
	
 	modus_utils.removeBorderColor(inSf.cntry, false);
 	modus_utils.removeBorderColor(inSf.contact, false);
 	
 	if ( isRequired  || !modus_utils.is_empty( inSf.area ) || !modus_utils.is_empty( inSf.contact)   ) {
 		modus_utils.errMsg = "Country Code is Required";
 		if ( modus_utils.checkObj(inSf.cntry, focus, false) ) {
 			errcnt++;
 			focus = false;
 		}
 	}
 	
 	if ( isRequired  || !modus_utils.is_empty( inSf.area ) || !modus_utils.is_empty( inSf.cntry)   ) {
	 	modus_utils.errMsg = "Contact Number is required";
	 	if ( modus_utils.checkObj(inSf.contact, focus, false) ) {
	 		errcnt++;
	 		focus = false;
	 	}
	}
	
	if (errcnt == 0) {
		if ( (!modus_utils.is_empty( inSf.cntry)) &amp;&amp;  (!modus_utils.is_empty( inSf.contact)) &amp;&amp;  (inSf.cntry.rawValue == "65") ) {
			//check for SG, number is 8 digits
			inSf.area.rawValue = "";
			if (inSf.contact.rawValue.length != 8)	{
				modus_utils.errMsg = "Singapore Contact Number must be 8 digits in length";
				modus_utils.changeBorderColorRed(inSf.contact);
				errcnt++;
	 		focus = false;
			}
		}
	}
			
			
	return errcnt;
 }

 //==============================
 function checkToken( inSF) {
 
 	var errCnt = 0;
 	
 	modus_utils.removeBorderColor(inSF, false);
 
  	if (modus_utils.is_empty(inSF.part1) || modus_utils.is_empty(inSF.part2)  || modus_utils.is_empty(inSF.part3) ) {
  		//console.println("empty");
 		modus_utils.errMsg = "Incomplete token serial number";
 		modus_utils.changeBorderColorRed(inSF);
 		errCnt++;	
 	}
 	
 	if (errCnt == 0) {
 		if ((inSF.part1.rawValue.length != 2) || (inSF.part2.rawValue.length != 7) || (inSF.part3.rawValue.length != 1)) {
 			//console.println("length : " + inSF.part1.rawValue.length + " - " + inSF.part2.rawValue.length + " - " + inSF.part3.rawValue.length);
 		 	modus_utils.errMsg = "Incomplete token serial number";
 			modus_utils.changeBorderColorRed(inSF);
 			errCnt++;	
 		}
 	}
 	
 	return errCnt;
 }

//==================
 function validateDate( inSF,  isRequired , futureDated) {
 
  	//This is to validate a date field with YY in the year
 	//use validateDate2 if year is YYYY
 
 	//futureDated = true, date must be in the future
 	//futureDated = false, date must be in the past
 
 	var errcnt = 0;
 	
 	//remove error
 	modus_utils.removeBorderColor( inSF, false );
 	
 	
 	if ( !isRequired  &amp;&amp; modus_utils.is_empty( inSF.dateDD) &amp;&amp;  modus_utils.is_empty( inSF.dateMM) &amp;&amp;  modus_utils.is_empty( inSF.dateYY) ) {
 		//all fields are blank and the date is not required
 		return errcnt ;
 	}
 	
 	//get current date
 	var cdate = new Date();   
	cdate.setHours(0,0,0,0); // &lt;== set the hours to midnight.
	
 	//check if day value is provided.
	if (  modus_utils.is_empty( inSF.dateDD) || inSF.dateDD.rawValue &lt; 1 || inSF.dateDD.rawValue &gt; 31 ) {
 			modus_utils.errMsg = "Date is incorrect";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;		
     }
 
 	//check if month value is provided.
 	if (  modus_utils.is_empty( inSF.dateMM) || inSF.dateMM.rawValue &lt; 1 || inSF.dateMM.rawValue &gt; 12 ) {
 			modus_utils.errMsg = "Date is incorrect";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;		
 	}
   
     
    //check if year value is provided.
 	if (  modus_utils.is_empty( inSF.dateYY) ) {
 			modus_utils.errMsg = "Date is incorrect";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;		
    }
 	
 	//check if all 3 combined make a valid date
 	var fullYear = 2000 + inSF.dateYY.rawValue ;
 	if (futureDated == false) {
  		if (cdate.getFullYear() &lt;= fullYear ) {
 			var fullYear = 1900 + inSF.dateYY.rawValue ;
 		}
 	}
 	var valDate = new Date(fullYear ,  	(inSF.dateMM.rawValue - 1), inSF.dateDD.rawValue ) ;    //&lt;==month is zero based
 	//console.println("valDate : " +  valDate  ) ;
 	//console.println("valDate.getDate() : " +  valDate.getDate() ) ;
 	//console.println("valDate.getMonth() : " +  valDate.getMonth()) ;
 	//console.println("valDate.getFullYear() : " +  valDate.getFullYear()) ;
 	
 	//valDate will change if user pass in 30 - feb, 31 april, ... The date will change to 3rd march (for 30 - feb), ... . so we check if the values passed are correct by checking the 
 	//value back with the value that were passed in. If this is the case then the date values are valid else there is an error 
 	if ( (valDate.getDate() != inSF.dateDD.rawValue) || (valDate.getMonth() != (inSF.dateMM.rawValue - 1))  ||  (valDate.getFullYear() != fullYear )) {
 			modus_utils.errMsg = "Date is incorrect";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;		
 	}
 	
 	if (futureDated == null) {
 		return errcnt;	
 	}
 	
 	if (futureDated) {
 		if (valDate &lt; cdate)  {
 			//must be today or in the future
  				modus_utils.errMsg = "Date appears to be in the past";
  				modus_utils.changeBorderColorRed( inSF);
 				errcnt++;
 				return errcnt;		
 		}
 	} else {
 		if (valDate &gt;= cdate) {
 			//must be in the past
 			modus_utils.errMsg = "Date appears to be in the future";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;	
 		}
 	}
 	
 	return errcnt;	
 }

//=================================
function validateDate2( inSF,  isRequired , futureDated) {
 
 	//This is to validate a date field with YYYY in the year
 	//use validateDate if year is YY
 
 	//futureDated = true, date must be in the future
 	//futureDated = false, date must be in the past
 
 	var errcnt = 0;
 	
 	//remove error
 	modus_utils.removeBorderColor( inSF, false );
 	
 	
 	if ( !isRequired  &amp;&amp; modus_utils.is_empty( inSF.dateDD) &amp;&amp;  modus_utils.is_empty( inSF.dateMM) &amp;&amp;  modus_utils.is_empty( inSF.dateYYYY) ) {
 		//all fields are blank and the date is not required
 		return errcnt ;
 	}
 	
 	//get current date
 	var cdate = new Date();   
	cdate.setHours(0,0,0,0); // &lt;== set the hours to midnight.
	
 	//check if day value is provided.
	if (  modus_utils.is_empty( inSF.dateDD) || inSF.dateDD.rawValue &lt; 1 || inSF.dateDD.rawValue &gt; 31 ) {
 			modus_utils.errMsg = "Date is incorrect";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;		
     }
 
 	//check if month value is provided.
 	if (  modus_utils.is_empty( inSF.dateMM) || inSF.dateMM.rawValue &lt; 1 || inSF.dateMM.rawValue &gt; 12 ) {
 			modus_utils.errMsg = "Date is incorrect";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;		
 	}
   
     
    //check if year value is provided.
 	if (  modus_utils.is_empty( inSF.dateYYYY) || inSF.dateYYYY.rawValue &lt; 1000 ) {
 			modus_utils.errMsg = "Date is incorrect";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;		
    }
 	
 	//check if all 3 combined make a valid date
 	var valDate = new Date(inSF.dateYYYY.rawValue,  	(inSF.dateMM.rawValue - 1), inSF.dateDD.rawValue ) ;    //&lt;==month is zero based

 	//console.println("valDate : " +  valDate  ) ;
 	//console.println("valDate.getDate() : " +  valDate.getDate() ) ;
 	//console.println("valDate.getMonth() : " +  valDate.getMonth()) ;
 	//console.println("valDate.getFullYear() : " +  valDate.getFullYear()) ;
 	
 	//valDate will change if user pass in 30 - feb, 31 april, ... The date will change to 3rd march (for 30 - feb), ... . so we check if the values passed are correct by checking the 
 	//value back with the value that were passed in. If this is the case then the date values are valid else there is an error 
 	if ( (valDate.getDate() != inSF.dateDD.rawValue) || (valDate.getMonth() != (inSF.dateMM.rawValue - 1))  ||  (valDate.getFullYear() != inSF.dateYYYY.rawValue)) {
 			modus_utils.errMsg = "Date is incorrect";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;		
 	}
 	
 	if (futureDated == null) {
 		return errcnt;	
 	}
 	
 	if (futureDated) {
 		if (valDate &lt; cdate)  {
 			//must be today or in the future
  				modus_utils.errMsg = "Date appears to be in the past";
  				modus_utils.changeBorderColorRed( inSF);
 				errcnt++;
 				return errcnt;		
 		}
 	} else {
 		if (valDate &gt;= cdate) {
 			//must be in the past
 			modus_utils.errMsg = "Date appears to be in the future";
 			modus_utils.changeBorderColorRed( inSF);
 			errcnt++;
 			return errcnt;	
 		}
 	}
 	
 	return errcnt;	
 }
 
//=================================
 function checkNric( fld , focus, isRequired ) {
 
 	var errCnt = 0;
 	var tmpString;
 	
 	//modus_utils.errMsg = "NRIC / Passport number is required";
 	if ( ( !isRequired  ) &amp;&amp; ( modus_utils.is_empty(fld) ) ) {
 		modus_utils.removeBorderColor( fld , false);
 	} else {
	 	if ( modus_utils.checkObj(fld , focus, false) == 1 ) {
	 		errCnt++;
	 	} else {
	 		tmpString = fld.rawValue;
	 		tmpString = tmpString == null?"":tmpString; 
	 		//console.println("tmpString : " + tmpString );
	 		if ( tmpString.length &lt; 6 ) {
	 			modus_utils.errMsg = "Minimum of 6 characters are required";
	 			modus_utils.changeBorderColorRed( fld );
	 			errCnt++;
	 		}
	 	}
	} 	
 	
 	return errCnt;
 }



//==============================================
 function overseasWithdrawDate( inSF ) {
 	
 	var errCnt = 0;
 	var fullYear;
 	var todaysDate = new Date();
 	var oneDay = 24*60*60*1000; // hours*minutes*seconds*milliseconds  
	var firstDate; 
	var secondDate; 

 	if (modus_utils.is_empty(inSF.fromDate.date.dateDD) &amp;&amp; 
 			modus_utils.is_empty(inSF.fromDate.date.dateMM) &amp;&amp; 
 			modus_utils.is_empty(inSF.fromDate.date.dateYY) &amp;&amp; 
 			modus_utils.is_empty(inSF.toDate.date.dateDD) &amp;&amp; 
 			modus_utils.is_empty(inSF.toDate.date.dateMM) &amp;&amp; 
 			modus_utils.is_empty(inSF.toDate.date.dateYY) ) {
 	
 		//all are empty
 		modus_utils.removeBorderColor( inSF.fromDate.date, false);
 		modus_utils.removeBorderColor( inSF.toDate.date, false);
 		return errCnt;
 	} 
 	
 	//check from date
 	if ( modus_local.validateDate( inSF.fromDate.date , true, true) == 0 ) {
 	 	//check if more than 90 days
 	 	fullYear = 2000 + inSF.fromDate.date.dateYY.rawValue ;
 		firstDate = new Date(fullYear , (inSF.fromDate.date.dateMM.rawValue - 1), inSF.fromDate.date.dateDD.rawValue) ;    //&lt;==month is zero based
 		var diffDays = Math.round(Math.abs((todaysDate.getTime() - firstDate.getTime())/(oneDay)));
 		//console.println("diffDays firstDate  : "  +diffDays );
 		if (diffDays &gt; 90) {
 			modus_utils.errMsg = "More than 90 days in the future";
	 		modus_utils.changeBorderColorRed(  inSF.fromDate.date );
	 		errCnt++;
 		}
 
 	 } else {
 		errCnt++;
 	}
 	
 	//check to-date
 	if ( modus_local.validateDate( inSF.toDate.date , true, true) == 0 ) {
 	 	//check if more than 365 days
 	 	fullYear = 2000 + inSF.toDate.date.dateYY.rawValue ;
 		secondDate = new Date(fullYear , (inSF.toDate.date.dateMM.rawValue - 1), inSF.toDate.date.dateDD.rawValue) ;    //&lt;==month is zero based
 		var diffDays = Math.round(Math.abs((todaysDate.getTime() - secondDate.getTime())/(oneDay)));
 		//console.println("diffDays secondDate : "  +diffDays );
 		if (diffDays &gt; 365) {
 			modus_utils.errMsg = "More than 365 days in the future";
	 		modus_utils.changeBorderColorRed(  inSF.toDate.date );
	 		errCnt++;
 		} 	 	
 	 	
 	 } else {
 		errCnt++;
 	}
 	
 	if (errCnt == 0 ) {
 		//no errors found yet
 		//check if second date (to-date) is after first date (from-date)
 		if (secondDate &lt;= firstDate ) {
 			modus_utils.errMsg = "To-date before or equal From-date";
	 		modus_utils.changeBorderColorRed(  inSF.toDate.date );
	 		errCnt++;
 		}
 	}
 
 	return errCnt;
 }



function getBcAccountNumber() {
	//console.println("getBcAccountNumber" );
	var tmpString = "";
	
	var i;
	var node;
	
	if (Main.auth.selector.selAccounts.rawValue == "2") {
		for (i=0;i&lt;Main.auth.accounts._account.count;i++) {
			node = xfa.resolveNode("Main.auth.accounts.account[" + i + "]") ;
			tmpString  += addField( node.ocbcAcc ) ;
		}
		
		for(;i&lt;6;i++) {
			tmpString += "|";
		}
	
	} else {
		tmpString = "||||||";
	}
	//console.println("tmpString : " + tmpString);
	return tmpString;

}

