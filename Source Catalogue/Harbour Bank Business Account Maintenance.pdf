function getBcUsers() {
	
	var tmpString = "";
	
	var i;
	var node;
	

	for (i=0;i&lt;updEalerts.userDtls.dtls._sfUsers.count;i++) {
		node = xfa.resolveNode("updEalerts.userDtls.dtls.sfUsers[" + i + "]") ;
		tmpString  += addField(	node.usr.nameDetails.salutation );
		tmpString  += addField(	node.usr.nameDetails.fullName );
		tmpString  += addField(	node.usr.nameDetails.icNo );
		
		tmpString  += addField( node.usr.nameDetails.contactDtls.phone.cntry );
		tmpString  += addField( node.usr.nameDetails.contactDtls.phone.area );
		tmpString  += addField( node.usr.nameDetails.contactDtls.phone.contact );
		tmpString  += addField( node.usr.nameDetails.contactDtls.mobile.cntry );
		tmpString  += addField( node.usr.nameDetails.contactDtls.mobile.area );
		tmpString  += addField( node.usr.nameDetails.contactDtls.mobile.contact );
		tmpString  += addField( node.usr.nameDetails.contactDtls.fax.cntry );
		tmpString  += addField( node.usr.nameDetails.contactDtls.fax.area );
		tmpString  += addField( node.usr.nameDetails.contactDtls.fax.contact );
		tmpString  += addField( node.usr.nameDetails.contactDtls.email );
		
		if (updEalerts.termination.dtls.termPhoneBank.rawValue == "1") {
			tmpString  += "|||||||||||||||";
		} else {
			tmpString  += addField( node.sfPhoneBnk.phoneBanking );
			tmpString  += addField( node.sfPhoneBnk.mainDtls.phoneCode );
			tmpString  += addField( node.sfPhoneBnk.dtls.RadioButtonList );
			tmpString  += getBcUsersAccounts( node.sfPhoneBnk );  //updEalerts.userDtls.dtls.sfUsers.sfPhoneBnk.accounts.account.ocbcAcc
		}
		
		if (updEalerts.termination.dtls.termEalerts.rawValue == "1") {
			tmpString  += "||||||||||||";
		} else {
			tmpString  += addField( node.sfeAlert.title.eAlerts );   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.title.eAlerts
			tmpString  += addField( node.sfeAlert.dtls.selection.recType );  //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.selection.recType.accAccount
			tmpString  += addField( node.sfeAlert.dtls.userAccount.recType);  //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.userAccount.recType.user
			tmpString  += addField( node.sfeAlert.dtls.accDetails.sfLeft.cash );   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.cash
			tmpString  += addField( node.sfeAlert.dtls.accDetails.sfLeft.eAlert.trade );    //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.eAlert.trade
			tmpString  += addField( node.sfeAlert.dtls.accDetails.sfLeft.cashDetails.ocbcAcc );
			tmpString  += addField( node.sfeAlert.dtls.accDetails.sfLeft.cashDetails.options.lang );
			tmpString  += addField( node.sfeAlert.dtls.accDetails.sfLeft.cashDetails.options.via );
			tmpString  += addField( node.sfeAlert.dtls.accDetails.sfRight.amount );;
			tmpString  += addField( node.sfeAlert.dtls.optFeature.alert );
			tmpString  += addField( node.sfeAlert.dtls.optFeature.timeDeposit );
			tmpString  += addField( node.sfeAlert.dtls.optFeature.ocbcAcc );
		}
		
		tmpString  += addField( node.sfSms.title.sms );
		tmpString  += addField( node.sfSms.dtls.local.recType );
		tmpString  += addField( node.sfSms.dtls.local.amounts.amts );		
		tmpString  += addField( node.sfSms.dtls.overseas.recType );
		tmpString  += addField( node.sfSms.dtls.overseas.amounts.amts );
		tmpString  += addField( node.sfSms.dtls.other.recType );
		tmpString  += addField( node.sfSms.dtls.other.amounts.amts );
				
	}
	
	for(;i&lt;updEalerts.userDtls.dtls._sfUsers.max;i++) {
		tmpString += "|||||||||||||||||||||||||||||||||||||||||||||||";
	}
	
	//console.println("tmpString : " + tmpString);
	return tmpString;

}


function getBcUsersAccounts( inSF ) {
	
	var tmpString = "";
	
	var i;
	var node;
	
	for (i=0;i&lt;inSF.accounts._account.count;i++) {
		node = inSF.resolveNode("accounts.account[" + i + "]") ;
		tmpString  += addField( node.recType );
		tmpString  += addField( node.ocbcAcc );
	}
	
	for(;i&lt;inSF.accounts._account.max ;i++) {
		tmpString += "||";
	}
	
	return tmpString;

}	

function addField( inFld ) {

	var seperator = "|";
	if (inFld.rawValue == null) {
		return  seperator;
	} else {
		return inFld.rawValue + seperator;
	}
}  //=========================================


