1</integer><integer>0</integer><integer>2</integer></items><bind match="none"/></field></subform><breakBefore target="envelop" targetType="pageArea"/><bind match="none"/><?templateDesigner expand 0?></subform><subform w="100mm" name="hidden" layout="tb" presence="hidden"><bind match="none"/><field name="oneDSignature" w="62mm" h="9mm"><ui><textEdit><border><edge stroke="lowered"/></border><margin/></textEdit></ui><font typeface="Adobe Arabic"/><margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><caption reserve="25mm"><font size="8pt" typeface="Arial"/><para vAlign="middle"/><value><text>Signature</text></value></caption><bind match="global"/><value><text>BC001E501</text></value></field><field name="oneDContact" w="62mm" h="9mm"><ui><textEdit><border><edge stroke="lowered"/></border><margin/></textEdit></ui><font typeface="Adobe Arabic"/><margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><caption reserve="25mm"><font size="8pt" typeface="Arial"/><para vAlign="middle"/><value><text>Contact</text></value></caption><bind match="global"/><value><text>BC001E502</text></value></field><field name="oneDBusiness" w="62mm" h="9mm"><ui><textEdit><border><edge stroke="lowered"/></border><margin/></textEdit></ui><font typeface="Adobe Arabic"/><margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><caption reserve="25mm"><font size="8pt" typeface="Arial"/><para vAlign="middle"/><value><text>business</text></value></caption><bind match="global"/><value><text>BC001E503</text></value></field><field name="oneDdnc" w="62mm" h="9mm"><ui><textEdit><border><edge stroke="lowered"/></border><margin/></textEdit></ui><font typeface="Adobe Arabic"/><margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><caption reserve="25mm"><font size="8pt" typeface="Arial"/><para vAlign="middle"/><value><text>DNC</text></value></caption><bind match="global"/><value><text>BC001E504</text></value></field><field name="oneDeAlerts" w="62mm" h="9mm"><ui><textEdit><border><edge stroke="lowered"/></border><margin/></textEdit></ui><font typeface="Adobe Arabic"/><margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><caption reserve="25mm"><font size="8pt" typeface="Arial"/><para vAlign="middle"/><value><text>eAlerts</text></value></caption><bind match="global"/><value><text>BC001E505</text></value></field><field name="allowPrintBlank" w="62mm" h="9mm"><ui><textEdit><border><edge stroke="lowered"/></border><margin/></textEdit></ui><font typeface="Adobe Arabic"/><margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><caption reserve="25mm"><font size="8pt" typeface="Arial"/><para vAlign="middle"/><value><text>allowPrintBlank</text></value></caption><bind match="dataRef" ref="$.dbData.meta.allowPrintBlank"/></field><?templateDesigner expand 0?></subform><proto/><desc><text name="version">V2.6.4.</text><text name="title">Business Account Maintenance</text><text name="contact">support@harbourbank.example</text><text name="created">April 2018</text><text name="department">Modus Consulting Pte Ltd</text><text name="creator">Modus Consulting Pte Ltd - ES</text><text name="description">Modus Consulting Pte Ltd&#13;
</text><text name="issued">Aug 2026</text></desc><variables><script contentType="application/x-javascript" name="modus_utils">

// ==================================================================
// Copyright Modus Consulting Pte. Ltd 2010 - 2017 all rights reserved
// ==================================================================

//var BORDER_EDGE_RED_COLOR     		= "255,0,0";
var BORDER_EDGE_RED_COLOR     		= "227,6,19";   //this is OCBC red
var BORDER_EDGE_BLUE_COLOR 			= "30,41,220";
var BORDER_EDGE_BLACK_COLOR    		= "31,31,31";   //OCBC black

var BORDER_EDGE_GRAY_COLOR    		= "102,102,102"; //"128,128,128";
var BORDER_EDGE_LIGHT_GRAY_COLOR    = "230,230,230";
var BORDER_EDGE_THICKNESS 			= "0.508mm";
var BORDER_EDGE_THICKNESS_ORIGINAL 	= "0.1764mm"; 
var BORDER_EDGE_THICKNESS_RADIO 	= "0.25mm";  //"0.1764mm";  //0.25mm
var DATE_SEPARATOR 					= "/";
var MAX_ENTERED_FLOAT				= 1000000;
var MAX_ENTERED_INT					= 500000;
var MAX_ENTERED_PERCENT				= 100;
var MAX_ENTERED_DAYS				= 366;
var MAND_ALLOWED_BAG				= "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ123456789";
var MAND_TEXT_NO_BAG				= true;
var MAND_NUMERIC_NO_ZEROS			= true;
var errMsg 							= "";
var specialPrintBlank				= false;  //special prrint in case the hidden button is selected avavilein in the bankuse section "Attended by " field
	   											//this is to ensure the whole form, including the first section is empty for pritnig thrue blank forms

// =============================================================================
// UTILITIES VISUAL
// =============================================================================

function checkObj(obj, focus, cell) {

	//console.println(obj1.rawValue);
	if ( obj.className == "exclGroup" ) {
			return checkRadioGroup(obj, focus);
	} else { 
		if (obj.ui.oneOfChild.className == "checkButton") {
			return checkCheckBox(obj, focus);
		} else if (obj.ui.oneOfChild.className == "dateTimeEdit") {
			return modus_local.chkDate( obj, focus) ;
		} else {
			return checkSet(obj, focus, cell);
		}
	}
}

function checkSet(fobj, focus, cell){
	
	if ( ! checkCell(fobj)){
		changeBorderColorRed(fobj);
		if(focus == true)
			xfa.host.setFocus(fobj);
		return true;
	} else { 
		removeBorderColor(fobj,cell);
		return false;
	}
}

function checkNotZero(fobj, focus, cell){
		//field is mandatory and cannot be zero
	if ( ! checkCell(fobj)){
		if (mandatory) {
			changeBorderColorRed(fobj);
			if(focus == true)
				xfa.host.setFocus(fobj);
			return true;
		} else {
			removeBorderColor(fobj,cell);
			return false;
		}
	} else { 
		//console.println("checkNotZero: " + fobj.rawValue ) ;
		if (fobj.rawValue == 0 ) {
			if(focus == true)
				xfa.host.setFocus(fobj);
			return true;
		} else {
			removeBorderColor(fobj,cell);
			return false;
		}
	}

}

function checkCheckBox(fobj, focus) {
	if ( ! checkCell(fobj))  {
		changeCheckBoxColorRed (fobj);
		if(focus == true)
			xfa.host.setFocus(fobj);
		//if(mand == true)
		//	fobj.mandatory = "error";
		return true;
	} else { 
		removeCheckBoxColorRed (fobj);
		return false;
	}
 
}

function checkRadioGroup(fobj, focus) {
	if ( ! checkCell(fobj))  {
		changeRadioGroupColorRed (fobj);
		if(focus == true)
			xfa.host.setFocus(fobj);
		return true;
	} else { 
		removeRadioGroupColorRed (fobj);
		return false;
	}
 
}

// =============================================================================
function checkCell(fobj){
	
	var fval = fobj.rawValue;
	if(fval == null)
		return false;
	if(fobj.className == "field") {
		// STRING VALUES	
		if ( fobj.ui.oneOfChild.className == "textEdit") {
			if(modus_utils.MAND_TEXT_NO_BAG)
				return (fval != "") 
			else
				return modus_utils.checkCharsInBag(fval,modus_utils.MAND_ALLOWED_BAG); 
		}
		if ( fobj.ui.oneOfChild.className == "checkButton") {
				return (fval != "")  
		}		
		// NUMERIC VALUES
		if( fobj.ui.oneOfChild.className == "numericEdit") {
			if(modus_utils.MAND_NUMERIC_NO_ZEROS) 
				return (fval != 0);
			else
				return true;	
		}
		// Date
		if( fobj.ui.oneOfChild.className == "dateTimeEdit") {
			if ( !is_empty(fobj) ) {
				//validate the date
				var cnt = valDateFormat( fobj, false);
				
				if (cnt != 0 ) {
					return false;
				} else {
					return true;
				}
			} else {
				return true;	
			}
		}
		
		// CATCH ALL
		return (fval != "")
	}
	return (fval != "")
}
// =============================================================================
function checkCellFilled(fobj){
	if(fobj.rawValue == null)
		return false;
	return (fobj.rawValue != "")
}

// =============================================================================
function changeBorderColorRed( object ) {
		
		object.border.getElement('edge', 0).color.value = BORDER_EDGE_RED_COLOR; 
		object.border.getElement('edge', 0).thickness = BORDER_EDGE_THICKNESS;
		object.border.getElement('edge', 0).presence = "visible";
		object.border.getElement('edge', 1).color.value = BORDER_EDGE_RED_COLOR; 
		object.border.getElement('edge', 1).thickness = BORDER_EDGE_THICKNESS;
		object.border.getElement('edge', 1).presence = "visible";
		object.border.getElement('edge', 2).stroke = "solid";
		object.border.getElement('edge', 2).color.value = BORDER_EDGE_RED_COLOR; 
		object.border.getElement('edge', 2).thickness = BORDER_EDGE_THICKNESS;
		object.border.getElement('edge', 2).presence = "visible";
		object.border.getElement('edge', 3).color.value = BORDER_EDGE_RED_COLOR; 
		object.border.getElement('edge', 3).thickness = BORDER_EDGE_THICKNESS;
		object.border.getElement('edge', 3).presence = "visible";
		
		setErrMsg( object );
}
// =============================================================================
function changeBorderColorBlue( object ) {
		object.border.edge.color.value = BORDER_EDGE_BLUE_COLOR;
		object.border.edge.thickness   = BORDER_EDGE_THICKNESS;
		object.border.edge.presence    = "visible";
		
		setErrMsg( object );
}
// =============================================================================
function changeBorderColorBlack( object ) {
		object.border.edge.color.value = BORDER_EDGE_BLACK_COLOR;
		object.border.edge.thickness   = BORDER_EDGE_THICKNESS_ORIGINAL;
		
		setErrMsg( object );
}
// =============================================================================
function removeBorderColor( object, cell ) {
	//console.println("removeBorderColor : " + object.somExpression + " cell:" + cell  );
		if(cell)
		{	
				
			object.border.getElement('edge', 0).color.value = BORDER_EDGE_GRAY_COLOR;
			object.border.getElement('edge', 0).thickness = BORDER_EDGE_THICKNESS_ORIGINAL;
			object.border.getElement('edge', 1).color.value = BORDER_EDGE_GRAY_COLOR;
			object.border.getElement('edge', 1).thickness = BORDER_EDGE_THICKNESS_ORIGINAL;
			object.border.getElement('edge', 2).color.value = BORDER_EDGE_GRAY_COLOR;
			object.border.getElement('edge', 2).thickness = BORDER_EDGE_THICKNESS_ORIGINAL;
			object.border.getElement('edge', 3).color.value = BORDER_EDGE_GRAY_COLOR;
			object.border.getElement('edge', 3).thickness = BORDER_EDGE_THICKNESS_ORIGINAL;
			
		}
		else 
		{
			object.border.getElement('edge', 0).presence = "hidden";
			object.border.getElement('edge', 0).thickness = BORDER_EDGE_THICKNESS_ORIGINAL;
			object.border.getElement('edge', 1).presence = "hidden";
			object.border.getElement('edge', 1).thickness = BORDER_EDGE_THICKNESS_ORIGINAL;
			object.border.getElement('edge', 2).presence = "hidden";
			object.border.getElement('edge', 2).thickness = BORDER_EDGE_THICKNESS_ORIGINAL;
			object.border.getElement('edge', 3).presence = "hidden";
			object.border.getElement('edge', 3).thickness = BORDER_EDGE_THICKNESS_ORIGINAL;
		}	
		
		removeErrMsg( object) ;		
}
// =============================================================================
function changeCheckBoxColorRed ( inObj ) {
		inObj.resolveNode("ui.checkButton.border").edge.color.value =  BORDER_EDGE_RED_COLOR ;
		inObj.resolveNode("ui.checkButton.border").edge.thickness = BORDER_EDGE_THICKNESS ;
		
		setErrMsg( inObj );
}

function removeCheckBoxColorRed ( inObj ) {
		inObj.resolveNode("ui.checkButton.border").edge.color.value =  BORDER_EDGE_GRAY_COLOR ; //BORDER_EDGE_BLACK_COLOR  ; 
		inObj.resolveNode("ui.checkButton.border").edge.thickness = BORDER_EDGE_THICKNESS_RADIO  ;
		
		removeErrMsg( inObj ) ;
}
// =============================================================================
function changeRadioGroupColorRed ( inObj ) {
	
	var oNodes = inObj.nodes;
	for (var i=0; i &lt; oNodes.length; i++) {
  		if (oNodes.item(i).className == "field") {
  			if (oNodes.item(i).access != "protected") {
				oNodes.item(i).ui.checkButton.border.edge.color.value =  BORDER_EDGE_RED_COLOR ;
				oNodes.item(i).ui.checkButton.border.edge.thickness =   BORDER_EDGE_THICKNESS ;
			}
    	}
  	}
  	setErrMsg( inObj );
	 
}
	

function removeRadioGroupColorRed ( inObj ) {
	var oNodes = inObj.nodes;
	for (var i=0; i &lt; oNodes.length; i++) {
  		if (oNodes.item(i).className == "field") {
  			if (oNodes.item(i).access != "protected") {
				oNodes.item(i).ui.checkButton.border.edge.color.value =  BORDER_EDGE_GRAY_COLOR ; //BORDER_EDGE_BLACK_COLOR   ;   
				oNodes.item(i).ui.checkButton.border.edge.thickness =    BORDER_EDGE_THICKNESS_RADIO ;
			}
    	}
  	}
  
  	removeErrMsg( inObj ) ;
}

// =============================================================================
function setErrMsg( obj ) {
	
	//if (errMsg == "") {
	//	return;
	//}

	var objname = obj.name;
	objname = "err_" + objname;	
	var somExp = obj.somExpression;  //get full path  
	var lastIdx = somExp.lastIndexOf(".") + 1;  //+ 1 as we need to include the dot in the substing later
	objname  = somExp.substring(0,lastIdx) + objname ;
	var eobj= xfa.resolveNode(objname);
	if (eobj == null) {
		return
	}
	
	eobj.rawValue = errMsg;
	errMsg = "";
	
}

function removeErrMsg( obj ) {

	var objname = obj.name;
	objname = "err_" + objname;	
	var somExp = obj.somExpression;  //get full path  
	var lastIdx = somExp.lastIndexOf(".") + 1;  //+ 1 as we need to include the dot in the substing later
	objname  = somExp.substring(0,lastIdx) + objname ;
	var eobj= xfa.resolveNode(objname);
	if (eobj == null) {
		return
	}
	
	eobj.rawValue = "";
	errMsg = "";
}

// =============================================================================

function is_empty( r_fld )
{        
  	if ( r_fld.className == "draw") {
  		return true;
  	}
  	
    if(r_fld.className == "exclGroup")
    {
        return is_radiobtn_empty(r_fld);
    }

    switch (r_fld.ui.oneOfChild.className)
    {
        case "checkButton":                
            if (r_fld.parent.className == "exclGroup")
            {
                // checkButtons inside exclusion groups are radio buttons
                return is_radiobtn_empty(r_fld);
            }
            else
            {
				// otherwise, they're check boxes
                return is_checkbox_empty(r_fld);                    
            }
            break;        
        case "choiceList":
            var oUITypeNode = r_fld.ui.resolveNode("#choiceList");                
            if (oUITypeNode.open == "userControl")
            {
				// drop down list / combo box
                return is_dropdown_empty(r_fld);
            }
            else
            {
				// otherwise, it's a list box
            }
            break;
        case "dateTimeEdit": 
            return is_textfield_empty(r_fld);
            break;
        case "imageEdit":   
        	return is_imageField_empty(r_fld);                   
            break;
        case "numericEdit":                
            return is_numericEdit_empty(r_fld);
            break;
        case "passwordEdit":                 
            break;
        case "textEdit":
            return is_textfield_empty(r_fld);
            break;            
        default:
            break;
    }

    function is_dropdown_empty( r_dropdown )
    {
        if(r_dropdown.rawValue == "-1" 
            || r_dropdown.rawValue ==""
            || r_dropdown.rawValue ==" "
            || r_dropdown.rawValue == null)
            return true;
        else
            return false;              
    }

    function is_textfield_empty(r_field)
    {
        if(r_field.rawValue == "" || r_field.rawValue == null)
            return true;
        else
            return false;    
    }

    function is_numericEdit_empty(r_field)
    {
        if(r_field.rawValue == null)
            return true;
        else
            return false;                
    }

    function is_checkbox_empty(r_checkbox)
    {
        if(r_checkbox.rawValue == 0 || r_checkbox.rawValue == null)
            return true;
        else
            return false;    
    }

    function is_radiobtn_empty(r_radiobtn)
    {
        if(r_radiobtn.rawValue == "" || r_radiobtn.rawValue == null)
            return true;
        else
            return false;                
    }
    function is_imageField_empty(fld) {
    	//console.println("imageField : " );
     	if (fld.rawValue == null || fld.rawValue.length == 0 ) {
     		return true;
        } else {
            return false;    
    	}
    }    
}



function valDateFormat( obj, focus  ) {

	 var errCnt = 0;
	 //console.println("date valDateFormat obj.rawValue: " + obj.rawValue);
	//check if valid string
	if ( !is_empty( obj ) ){
	 	var tmpDate = util.scand("yyyy-mm-dd", obj.rawValue);
	 	if (tmpDate == null) {
	 		modus_utils.changeBorderColorRed(obj );
		 	if (focus == true) {
				xfa.host.setFocus(obj );
				focus = false;
			}
	 		errCnt++;
	 	} else {
	 		modus_utils.removeBorderColor(obj );
	 	}
	 	
	 } else {
	 	if ( checkSet( obj , focus  , false) ) {
	 		errCnt++;	
	 	};
  	}

	return errCnt;
}

//Special

function setPicture(currFld, amtFld) {

	var str = "";
	var tempString = "";

	var numOfDigits = 0;
	if ( modus_utils.is_empty(currFld)) {
		numOfDigits = 2; //default
	} else {

		switch (currFld.rawValue) {
			case "VND":
			case "JPY":
			case "YEN":
			case "KRW":
				numOfDigits = 0;
				break;
			default:
				numOfDigits = 2;
		}
			
	}

	switch (numOfDigits) {
	case 0:
		tempString = "zzz,zzz,zzz,zzz,zz9";
		break;
	case 1:
		tempString = "zz,zzz,zzz,zzz,zz9";
		break;
	case 2:
		tempString = "z,zzz,zzz,zzz,zz9";
		break;
	case 3:
		tempString = "zzz,zzz,zzz,zz9";
		break;
	case 4:
		tempString = "zz,zzz,zzz,zz9";
		break;
	case 5:
		tempString = "z,zzz,zzz,zz9";
		break;
	default:
		tempString = "z,zzz,zzz,zzz,zz9";
		break;
	}

	//set the size of decimal places of the field
	//amtFld.resolveNode("value.#decimal").leadDigits = String( (13 - numOfDigits) ) ;
	amtFld.resolveNode("value.#decimal").fracDigits = String(numOfDigits);

	if (numOfDigits != 0) {
		tempString = tempString + ".";

		numOfDigits = numOfDigits + 1;
		str = Array(numOfDigits).join("9");
		//console.println("str : " + str );
		tempString = tempString + str;
	} else {
		if ( !modus_utils.is_empty( amtFld ) ) {
			amtFld.rawValue = Math.floor(amtFld.rawValue);
		
		}
	}
	
	//console.println("tempString : " + tempString );
	amtFld.format.picture.value = "num{" + tempString + "}";
}

function getRadioLabel ( inObj ) {
	
	//return the label descrption of the selection radio option
	
	//passin object must be a radio group
	
	var oNodes = inObj.nodes;
	for (var i=0; i &lt; oNodes.length; i++) {
  		if (oNodes.item(i).className == "field") {
  			if (  oNodes.item(i).value.text.value == inObj.rawValue) {
  				//found
  				//console.println("getRadioLabel " + i + " found " + oNodes.item(i).caption.value.text.value);
  				return  oNodes.item(i).caption.value.text.value;
  			}
   		}
  	}
  	return null;
	 
}

function gotoPageNumber( obj ) {

 var num = xfa.layout.page( obj ); // 1-based. 
 num--; //need to make it zero based
 //console.println("num :" + num );
 var verNum = xfa.host.version;
 
 if (Number( verNum ) &lt; 9 ) {
 	 for (i=0;i &lt; num;i++) { 
 		xfa.host.pageDown();
 	}
 } else {
 	xfa.host.currentPage = num; 
 }
  event.target.scroll(0, 840);    //this will postion the screen postion to view the left upper corner of the page in focus. 0,0 is left lower corner, value here are in points, "0,840" will scroll to the top of the page
}
