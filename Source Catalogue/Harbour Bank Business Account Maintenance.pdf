</script></event><?templateDesigner expand 0?></subform><subform w="187mm" name="bankUse" layout="tb"><subform name="address"><draw name="Line9" y="4.082mm" x="99.9mm" w="0in" h="18mm"><value><line><edge thickness="0.32mm"><color value="128,128,128"/></edge></line></value></draw><bind match="none"/><margin leftInset="0mm" topInset="1mm" bottomInset="1mm"/><draw name="envelop" w="20mm" h="18mm" y="4.082mm" x="1.657mm"><value><text>*</text></value><ui><textEdit/></ui><para vAlign="middle" hAlign="center"/><font size="24pt" typeface="Wingdings"><fill><color value="64,64,64"/></fill></font><assist><speak disable="1"/></assist><margin leftInset="0mm"/><border><edge stroke="dashed" thickness="0.5mm" presence="hidden"><color value="128,128,128"/></edge><corner stroke="dashed" thickness="0.5mm" presence="hidden"><color value="128,128,128"/></corner></border><?renderCache.bounds 56693 51024 0 0 0 0 0 0?><?renderCache.textRun 1 * 0 14759 32590 64 64 64 "Wingdings" 0 0 24000 fontSpecific?></draw><?templateDesigner expand 0?><draw name="lbl" w="67.278mm" x="23.87mm" y="4.082mm" h="18mm"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="margin-bottom:2pt;font-weight:bold;letter-spacing:0in">Via Secured Mailbox on Harbour Bank online banking<span style="vertical-align:3pt;xfa-font-vertical-scale:70%">^</span></p><p style="letter-spacing:0in">Scan the completed and signed form. Log in to Harbour Bank online banking, click on â€˜Mailboxâ€™ on the top right &gt; â€˜Write mailâ€™ &gt; Select the subject â€˜(SG) Submit Acct/Velocity Update Formâ€™. Upload your scanned form, then submit the request.<span style="xfa-spacerun:yes">Â  </span></p></body></exData></value><ui><textEdit/></ui><para vAlign="middle" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt" marginLeft="0pt" marginRight="0pt"/><font size="7.6pt" typeface="Myriad Pro" baselineShift="0pt"><fill><color value="64,64,64"/></fill></font><assist><speak disable="1"/></assist></draw><draw name="lbl" w="67.278mm" x="112.223mm" y="4.082mm" h="18mm"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="margin-bottom:2pt;font-weight:bold;text-decoration:none;letter-spacing:0in">Via mail</p><p style="text-decoration:none;letter-spacing:0in">Harbour Bank</p><p style="text-decoration:none;letter-spacing:0in">Attn: Account Services</p><p style="text-decoration:none;letter-spacing:0in">Fictional service desk</p><p style="text-decoration:none;letter-spacing:0in">No postal submission</p></body></exData></value><ui><textEdit/></ui><para vAlign="middle" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt" marginLeft="0pt" marginRight="0pt"/><font size="7.6pt" typeface="Myriad Pro" baselineShift="0pt"><fill><color value="64,64,64"/></fill></font><assist><speak disable="1"/></assist></draw><draw name="lbl" w="67.278mm" x="23.87mm" y="0.521mm" minH="1mm"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="margin-bottom:2pt;font-weight:bold;text-decoration:none;letter-spacing:0in">Please mail the completed and signed form to us:</p></body></exData></value><ui><textEdit/></ui><para vAlign="middle" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt" marginLeft="0pt" marginRight="0pt"/><font size="7.6pt" typeface="Myriad Pro" baselineShift="0pt"><fill><color value="64,64,64"/></fill></font><assist><speak disable="1"/></assist></draw><draw name="helpAdd" h="4.5mm" x="23.87mm" w="115.063mm" y="21.96mm"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="vertical-align:3pt;xfa-font-vertical-scale:70%;text-decoration:none;letter-spacing:0in">^<span style="vertical-align:baseline;xfa-font-vertical-scale:100%">Online submission is available for all requests