function showSignDesc( errCnt , printMode) {
	//console.println("showSignDesc: " + errCnt );
	//printmode also use when locking the form
	//the text should be show smae as priting the form
	var fullDesc = "";
	if (errCnt != null &amp;&amp; errCnt == 0) {
		fullDesc = getMatrixText( null , printMode);	
	}
	
		
	var i;
	var node;
	for (i=0;i&lt;updSignature.sfSignature.dtls.Table1._Row1.count;i++) {
		node = updSignature.sfSignature.dtls.Table1.resolveNode("Row1[" + i + "]");
		
		//updSignature.sfSignature.dtls.Table1.Row1.tblDtls.fieldDtls.chgReq.recType
		if (fullDesc == "" || node.tblDtls.fieldDtls.chgReq.recType.rawValue == "3") {    //no desc if user is removed
			node.tblDtls.desc.presence = "hidden";
		} else {
			node.tblDtls.desc.presence = "visible";
			node.tblDtls.desc.Table5.Row2.txt.rawValue = fullDesc ;

		}
	}
}
//===========================
//===========
function validateSignDate( inSF, isRequired ) {
	
	var errCnt = 0;
	var backdatedLimit = 15;   //backdate up to 15 days in the past
	
	if (inSF.access == "protected") {
		return errCnt;
	}
	
	var errCnt = modus_local.validateDate( inSF, false, null);
	//valid date
	//console.println("validateSignDate : " + errCnt);
	if ( errCnt  == 0 &amp;&amp; ( !modus_utils.is_empty( inSF.dateDD) || !modus_utils.is_empty( inSF.dateMM) || !modus_utils.is_empty( inSF.dateYY) ) )  {
		
 		var fullYear = 2000 + inSF.dateYY.rawValue ;
 		var valDate = new Date(fullYear ,  	(inSF.dateMM.rawValue - 1), inSF.dateDD.rawValue ) ;    //&lt;==month is zero based
 		
 		var cdate = new Date();   
		cdate.setHours(0,0,0,0); // &lt;== set the hours to midnight. 		d.setDate(d.getDate()-5);
 		cdate.setDate(cdate.getDate()-backdatedLimit);  //&lt; current date less 15 days
 		
 		if (valDate &lt; cdate)  {
 			//to far in the past
 				//console.println("validateSignDate : to far in the past" );
  				modus_utils.errMsg = "Date more than " + backdatedLimit + " days ago";
  				modus_utils.changeBorderColorRed( inSF);
 				errCnt++;	
 		}
 		
 	}
	
	return errCnt;
}
//====================

function lockForm( mode ) {

	Main.access = mode;
	updSignature.access = mode;
	updContact.access = mode;
	updBusiness.access = mode;
	updDnc.access = mode;
	updEalerts.access = mode;

}
//====================

function setCurrentDate( inSF ) {

	if (modus_utils.is_empty(inSF.dateDD) &amp;&amp; modus_utils.is_empty(inSF.dateMM) &amp;&amp; modus_utils.is_empty(inSF.dateYY) ) {
		var cdate = new Date();
		inSF.dateYY.rawValue =  cdate.getFullYear() % 100;
		inSF.dateMM.rawValue =  cdate.getMonth() + 1;
		inSF.dateDD.rawValue =  cdate.getDate();
	}
}
//====================

function checkGroupMandatory() {

	//check for the signature sction if the GROUP indicattor is mandatory
	// returns true or false
	var i;
	var node;
	
	if (updSignature.sfSignature.dtls.signConditions.sfReplace.replace.rawValue == "1" &amp;&amp; updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions.rawValue == "3") {
		if (updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.attached.rawValue == "1") {
			return false;
		} else {
			for (i=0;i&lt;updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix._amtLine.count;i++) {
				node = updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.resolveNode("amtLine[" + i +"]");
				if (node.grouping._group.count &gt; 1) {
					return true;
				}
			}
		}
	}
	if (updSignature.sfSignature.dtls.signConditions.sfUpdate.update.rawValue == "1" &amp;&amp; updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions.rawValue == "3") {
		if (updSignature.sfSignature.dtls.signConditions.sfUpdate.authMatrix.attached.rawValue == "1") {
			return false;
		} else {
			for (i=0;i&lt;updSignature.sfSignature.dtls.signConditions.sfUpdate.authMatrix._amtLine.count;i++) {
				node = updSignature.sfSignature.dtls.signConditions.sfUpdate.authMatrix.resolveNode("amtLine[" + i +"]");
				if (node.grouping._group.count &gt; 1) {
					return true;
				}
			}
		}
	}
		
	
	for (i=0;i&lt;updSignature.sfSignature.dtls.Table1._Row1.count;i++) {
		//check if any of the Group fields in the table is provided
		if ( !modus_utils.is_empty(updSignature.sfSignature.dtls.Table1.resolveNode("Row1[" + i + "]").tblDtls.fieldDtls.group ) ) {
			return true;	
		}
	}		

	//fallback
	return false;

}

//=========================
function clearGroup() {
	
	var groupMandatory = checkGroupMandatory();
	
	if (groupMandatory != true) {
	
		//remove the error boxes
		var i;
		for (i=0;i&lt;updSignature.sfSignature.dtls.Table1._Row1.count;i++) {
			//check if any of the Group fields in the table is provided
			modus_utils.removeBorderColor(updSignature.sfSignature.dtls.Table1.resolveNode("Row1[" + i + "]").tblDtls.fieldDtls.group,true);
		}
		
	}
}
