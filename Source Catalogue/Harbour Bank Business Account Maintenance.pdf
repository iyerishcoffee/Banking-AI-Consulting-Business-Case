 var i;
 var errCnt = 0;
 var totErrCnt = 0;
 var node;
 var rtnCode;
 
 modus_local.show1Dbarcode = true;
 modus_local.show2Dbarcode = false;
	   
	   if ( modus_utils.specialPrintBlank &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.appName) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.busRegno) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.contact) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.phone.cntry) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.phone.area) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.phone.contact) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.mobile.cntry) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.mobile.area) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.mobile.contact) &amp;&amp;
	   		modus_utils.is_empty(Main.corpInfo.dtls.email) &amp;&amp;
	   		 modus_validate.verifyBlankForm()  ) {    
	   		
	   		//special prrint in case the hidden button is selected available in the bankuse section "Attended by " field
	   		//this is to ensure the whole form, including the first section is empty for printing thrue blank forms
	   		
	   		//page 1 section 2
 			errCnt += modus_local.checkOptions();
	   			
	   		if (errCnt != 0 ) {
	   			rtnCode= xfa.host.messageBox("Please make selection in section 2 before printing this form.", "Please review the form");
	   			xfa.event.cancelAction = 1;
	   		} else {
	   			printBlank();  //open sections to prepare the form for print blank
	   			printForm(); 
	   		}
	   } else {
	   		//All fields on page 1 are required 
	   		errCnt = modus_validate.validatePage1();
	   
		   if ( Main.hidden.allowPrintBlank.rawValue == "1" &amp;&amp; modus_validate.verifyBlankForm()  ) {
		   	   //print a blank for for the selected section, but page 1 is always mandatory
		   	   //console.println("inside prtBlank: " + errCnt );
		   	   if (errCnt != 0) {
			   		if (errCnt == 1) {
						rtnCode= xfa.host.messageBox("There is " + errCnt  + " field on the form that require your attention. This field is highlighted in red.\n\nPlease provide the necessary information before printing this form.", "Please review the form");
					} else {
						rtnCode= xfa.host.messageBox("There are " + errCnt  + " fields on the form that require your attention. They are highlighted in red.\n\nPlease provide the necessary information before printing this form.", "Please review the form");
					}
					xfa.event.cancelAction = 1;
			   }  else {
			   		printBlank();  //open sections to prepare the form for print blank
			   		printForm(); 
			   }
		   } else {
		   	 	//add error for the other pages to the total error of page 1
				totErrCnt = errCnt + modus_validate.validateForm();
				
				if (errCnt != 0) {
					//must fix all errors in section 1 before allowed to print, but we report all errors on the form
					if (totErrCnt == 1) {
						rtnCode= xfa.host.messageBox("There is " + totErrCnt + " field on the form that require your attention. This field is highlighted in red. \n\n Please correct the error before printing this form.", "Please review the form");
					} else {
						rtnCode= xfa.host.messageBox("There are " + totErrCnt + " fields on the form that require your attention. They are highlighted in red. \n\n Please correct these errors before printing this form.", "Please review the form");
					}
					xfa.event.cancelAction = 1;
				} else if (totErrCnt != 0) {
					if (totErrCnt == 1) {
						rtnCode= xfa.host.messageBox("There is " + totErrCnt + " field on the form that require your attention. This field is highlighted in red. \n\n Do you want to continue printing this form?", "Please review the form", 1, 2);
					} else {
						rtnCode= xfa.host.messageBox("There are " + totErrCnt + " fields on the form that require your attention. They are highlighted in red. \n\n Do you want to continue printing this form?", "Please review the form", 1, 2);
					}
					if (rtnCode== 4) {
						printForm();
					} else {
						//xfa.host.messageBox("Oops!\n\nPlease check that the details are correct before printing", "Validation Error", 1, 0);
						xfa.event.cancelAction = 1;
					}
				} else {
					//continue print
					
					//diabled as per keith email
					//modus_local.show2Dbarcode = true;
					printForm();
					
				}
			
			}
		}

function printForm() {
	
	//intro.presence = "hidden";
	 
	Main.auth.accounts.bcAccountDetails.rawValue =  modus_local.getBcAccountNumber().slice(0,-1);
	
	if (Main.options.dtls.signature.rawValue == "1") {
		modus_local.showSignDesc( 0, true);  //different text on actual printout
	}
		
	//set 2D barcode if 1D barcode is not set to be true
	if (modus_local.show2Dbarcode) {
		//if (Main.options.dtls.signature.rawValue == "1") {
		//	updSignature.sfSignature.bcSignatureDetails.rawValue = modus_local.getBcSignatures().slice(0,-1);
		//	updSignature.barCode.PaperFormsBarcode1.rawValue = manualBC.setBarCode( signBarcode );
