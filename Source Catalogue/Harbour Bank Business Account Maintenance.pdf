 modus_utils.checkObj( this, false, false);
 modus_print.removeBorderSF( this.parent );
 
 if (this.rawValue == "2" ) {
 	options.existingHead.presence = "visible";
 	options.atmSms.presence = "visible";
 	options.updateVelo.presence = "visible";
 	options.addHead.presence = "hidden";
 	options.delHead.presence = "hidden";
 	options.authContact.selected.rawValue = "0";
 	options.authContact.selected.access = "open";
 } else {
  	if (this.rawValue == "1" )  {
 		options.addHead.presence = "visible";
 	} else {
 		options.addHead.presence = "hidden";
 	}
 	if (this.rawValue == "3" )  {
 		options.delHead.presence = "visible";
 	} else {
 		options.delHead.presence = "hidden";
 	}
 	options.existingHead.presence = "hidden";
  	options.atmSms.presence = "hidden";
 	options.updateVelo.presence = "hidden";
 	options.authContact.selected.rawValue = "1";
 	options.authContact.selected.access = "protected";
 }
