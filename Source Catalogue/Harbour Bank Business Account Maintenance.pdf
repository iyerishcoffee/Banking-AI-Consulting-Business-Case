</script></event><bind match="dataRef" ref="$.signature.signName3"/><event activity="exit" name="event__exit"><script contentType="application/x-javascript">

 //modus_utils.errMsg = "Name is required as per NRIC/Passport";
 if (ImageField2.rawValue == null || ImageField2.rawValue.length == 0 ) {
 	//nithing
 } else {
 	modus_utils.checkObj( this, false, false);
 }
</script></event></field><event activity="initialize" name="event__initialize"><script contentType="application/x-javascript">
 //this.access = "protected";
</script></event><field name="clear" w="18mm" h="4mm" relevant="-print" x="37.052mm" y="1.252mm"><ui><button highlight="none"/></ui><font typeface="Adobe Arabic"/><caption><value><text>Clear Signature</text></value><para vAlign="middle" hAlign="center" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt" marginLeft="0pt" marginRight="0pt"/><font size="7pt" typeface="Myriad Pro" weight="bold" baselineShift="0pt"><fill><color value="255,255,255"/></fill></font></caption><border hand="right"><edge presence="hidden"/><fill><color value="51,51,51"/></fill><corner presence="hidden" thickness="0.176mm" join="round" radius="5px"/></border><bind match="none"/><assist><speak disable="1"/></assist><validate><script contentType="application/x-javascript">

 if (ImageField2.rawValue == null || ImageField2.rawValue.length == 0 ) {
 	ImageField3.access = "protected";
 	//auditor.access = "protected";
 	//signDate.date.access = "protected";
 	this.presence = "hidden";
 	
 
 	overlay3.presence = "visible";
	overlay3.relevant = "-print";
 } else {
 	ImageField3.access = "open";
 	//auditor.access = "open";
 	//signDate.date.access = "open";
 	overlay3.presence = "hidden";
 	
	if (ImageField3.rawValue == null || ImageField3.rawValue.length == 0 || ImageField3.access == "protected") {
	 	this.presence = "hidden";
	 	lblSigClick3.presence = "visible";
	 	lblSigClick3.relevant = "-print";
	 } else {
		var errCntName = modus_utils.checkObj(auditor, false, false);
		//var errcntDate = modus_local.validateDate( signDate.date, false, true);
		var errcntDate = modus_local.validateSignDate( signDate.date, false);
		
		if (errCntName != 0 &amp;&amp; errcntDate == 0 ) {
			var promptName = xfa.host.response("What is the Name of Authorised Signatory?","Name of Authorised Signatory","",false);
			//console.println("promptName : " + promptName );
			if (promptName == null || promptName == "") {
				//skip
			} else {
				auditor.rawValue = promptName;
				modus_utils.removeBorderColor(auditor,false);
				errCntName = 0;
			}
		}
				
		if (errCntName != 0 || errcntDate != 0 ) {

				ImageField3.rawValue = null;
		
				this.presence = "hidden";
 				lblSigClick1.presence = "visible";
 				lblSigClick1.relevant = "-print";
 		
				xfa.host.messageBox("Oops!\n\nPlease check that the details are correct before signing this document", "Validation Error", 1, 0);			
		} else {
			
	 		this.presence = "visible";
		 	this.relevant = "-print";
		 	lblSigClick3.presence = "invisible";
		 	
		 	nameDate1.clear.presence = "hidden";
		 	auditor.access = "protected";
			signDate.date.access = "protected";
			ImageField3.access = "protected";
			modus_local.setCurrentDate(signDate.date);
	 	}
	 }
 }
 true; 	
 	
</script></validate><event activity="click" name="event__click"><script contentType="application/x-javascript">		
	ImageField3.rawValue = null;
   
   	auditor.access = "open";
   	auditor.rawValue = "";
   	
   	nameDate1.clear.presence = "visible";
   	signDate.date.access = "open";
   	signDate.date.dateDD.rawValue = "";
   	signDate.date.dateMM.rawValue = "";
   	signDate.date.dateYY.rawValue = "";

	nameDate1.clear.execValidate();
</script></event></field><field name="clearAll" w="16mm" h="7mm" relevant="-print" x="39.052mm" y="10.059mm"><ui><button highlight="none"/></ui><font typeface="Adobe Arabic"/><caption><value><text>Clear All Signatures</text></value><para vAlign="middle" hAlign="center" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt" marginLeft="0pt" marginRight="0pt"/><font size="7pt" typeface="Myriad Pro" weight="bold" baselineShift="0pt"><fill><color value="255,255,255"/></fill></font></caption><border hand="right"><edge presence="hidden"/><fill><color value="51,51,51"/></fill><corner presence="hidden" thickness="0.176mm" join="round" radius="5px"/></border><bind match="none"/><assist><toolTip>This will clear all signatures and unlock this form</toolTip></assist><validate><script contentType="application/x-javascript">

 if (ImageField2.rawValue == null || ImageField2.rawValue.length == 0 ) {
 	this.presence = "hidden"; 
 } else {
	this.presence = "visible";	
	
 } 
 true; 	
 	
</script></validate><event activity="click" name="event__click"><script contentType="application/x-javascript">

 if (clear.presence == "visible") {
 	clear.execEvent("click");
 }
 if (nameDate1.clear.presence == "visible") {
 	nameDate1.clear.execEvent("click");
 }
 if (nameDate0.clear.presence == "visible") {
 	nameDate0.clear.execEvent("click");
 }
</script></event></field><?templateDesigner expand 0?></subform><draw name="overlay2" x="65mm" w="51mm" y="2.004mm" h="16mm"><value><text>To enable Signature 2, â€©please sign on Signature 1 </text></value><ui><textEdit/></ui><para vAlign="middle" hAlign="center"/><font size="8pt" typeface="Myriad Pro" fontHorizontalScale="95%"><fill><color value="51,51,51"/></fill></font><assist><speak disable="1"/></assist><margin topInset="2mm" rightInset="2mm" bottomInset="2mm" leftInset="2mm"/><border><edge stroke="dotted" thickness="0.25mm" presence="hidden"/><corner stroke="dotted" thickness="0.25mm" presence="hidden"/><fill><color value="230,230,230"/></fill></border></draw><draw name="overlay3" x="126mm" w="52mm" y="2.004mm" h="16mm"><value><text>To enable Signature 3, â€©please sign on Signature 2 </text></value><ui><textEdit/></ui><para vAlign="middle" hAlign="center"/><font size="8pt" typeface="Myriad Pro" fontHorizontalScale="95%"><fill><color value="51,51,51"/></fill></font><assist><speak disable="1"/></assist><margin topInset="2mm" rightInset="2mm" bottomInset="2mm" leftInset="2mm"/><border><edge stroke="dotted" thickness="0.25mm" presence="hidden"/><corner stroke="dotted" thickness="0.25mm" presence="hidden"/><fill><color value="230,230,230"/></fill></border></draw><traversal><traverse operation="first" ref="ImageField1[0]"/></traversal><event activity="initialize" name="event__initialize"><script contentType="application/x-javascript">
