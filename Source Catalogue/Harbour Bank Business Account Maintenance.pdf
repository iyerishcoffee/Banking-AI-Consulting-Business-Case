	} else {
	
		modus_utils.removeBorderColor(inSF.dtls.office.cntry, false); 
	 	modus_utils.removeBorderColor(inSF.dtls.office.area, false);
	 	modus_utils.removeBorderColor(inSF.dtls.office.contact, false);
	 	modus_utils.removeBorderColor(inSF.dtls.mobile.cntry, false);
	 	modus_utils.removeBorderColor(inSF.dtls.mobile.area, false);
	 	modus_utils.removeBorderColor(inSF.dtls.mobile.contact, false);
		
		if ( modus_utils.is_empty(inSF.dtls.office.cntry) &amp;&amp; 
			modus_utils.is_empty(inSF.dtls.office.area) &amp;&amp;
			modus_utils.is_empty(inSF.dtls.office.contact) &amp;&amp;
			modus_utils.is_empty(inSF.dtls.mobile.cntry) &amp;&amp;
			modus_utils.is_empty(inSF.dtls.mobile.area) &amp;&amp;
			modus_utils.is_empty(inSF.dtls.mobile.contact) ) {
				//console.println("required");
				modus_local.checkPhone(inSF.dtls.office, false, true);
				modus_local.checkPhone(inSF.dtls.mobile, false, true);
				errCnt = errCnt + 4;
		} else {
			//console.println("optionl");
			errCnt += modus_local.checkPhone(inSF.dtls.office, false, false);
			errCnt += modus_local.checkPhone(inSF.dtls.mobile, false, false);
		}
	}
	return errCnt;
	
}

function checkSignCondition() {
	var errCnt = 0;
	
	modus_utils.removeCheckBoxColorRed(updSignature.sfSignature.dtls.signConditions.existing, false, false); 
	modus_utils.removeCheckBoxColorRed(updSignature.sfSignature.dtls.signConditions.sfReplace.replace, false, false); 
	modus_utils.removeCheckBoxColorRed(updSignature.sfSignature.dtls.signConditions.sfUpdate.update, false, false); 
	if (modus_utils.is_empty(updSignature.sfSignature.dtls.signConditions.existing) &amp;&amp; modus_utils.is_empty(updSignature.sfSignature.dtls.signConditions.sfReplace.replace) &amp;&amp; modus_utils.is_empty(updSignature.sfSignature.dtls.signConditions.sfUpdate.update)) {
		 modus_utils.checkObj( updSignature.sfSignature.dtls.signConditions.existing, false , false);
		 modus_utils.checkObj( updSignature.sfSignature.dtls.signConditions.sfReplace.replace, false , false);
		 modus_utils.checkObj( updSignature.sfSignature.dtls.signConditions.sfUpdate.update, false , false);
		errCnt++;
	}  
	
	if (updSignature.sfSignature.dtls.signConditions.sfReplace.replace.rawValue == "1") {
		updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions.access = "open";
	} else {
		updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions.rawValue = "";
 		modus_utils.removeRadioGroupColorRed (updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions);
 		updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions.execInitialize()
 		updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions.access = "protected";
 	}
 	if (updSignature.sfSignature.dtls.signConditions.sfUpdate.update.rawValue == "1") {
		updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions.access = "open";
	} else {
		updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions.rawValue = "";
 		modus_utils.removeRadioGroupColorRed (updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions);
 		updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions.execInitialize()
 		updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions.access = "protected";
 	}

	return errCnt;
}


function checkPhoneBankSelection( inSF ) {
	var errCnt = 0;
	
	modus_utils.removeCheckBoxColorRed(inSF.existing, false, false); 
	modus_utils.removeCheckBoxColorRed(inSF.reactivate, false, false); 
	modus_utils.removeCheckBoxColorRed(inSF.terminate, false, false); 
	modus_utils.removeRadioGroupColorRed(inSF.RadioButtonList);
	
	if ( modus_utils.is_empty(inSF.existing) &amp;&amp;
		modus_utils.is_empty(inSF.reactivate) &amp;&amp;
		modus_utils.is_empty(inSF.terminate) &amp;&amp;
		modus_utils.is_empty(inSF.RadioButtonList) ) {
			modus_utils.checkObj(inSF.existing, false , false);
			modus_utils.checkObj(inSF.reactivate, false , false);
			modus_utils.checkObj(inSF.terminate, false , false);
			modus_utils.checkObj(inSF.RadioButtonList, false , false);
			errCnt++;
	}
	
	return errCnt;

}


function checkMobileSG( inSF ) {
	//check if mobile number is Singapore
	var errCnt = 0;
	modus_utils.removeBorderColor(inSF.cntry, false);
	if (!modus_utils.is_empty(inSF.cntry) ||
		!modus_utils.is_empty(inSF.area) ||
		!modus_utils.is_empty(inSF.contact) ) {
		if (inSF.cntry.rawValue != "65") {
			//update only
			modus_utils.errMsg = "Only Singapore numbers (Country Code '65') can be used for eAlert@ocbc";
			modus_utils.changeBorderColorRed(inSF.cntry);
			errCnt++;
		} 
	}			
	return errcnt;
}

function checkSMSalert( inSF) {
	//console.println(inSF.somExpression);
	var errCnt = 0;
	modus_utils.removeRadioGroupColorRed(inSF.local.recType);
	modus_utils.removeRadioGroupColorRed(inSF.overseas.recType);
	modus_utils.removeRadioGroupColorRed(inSF.other.recType);
	
	if (modus_utils.is_empty(inSF.local.recType) &amp;&amp;
		modus_utils.is_empty(inSF.overseas.recType) &amp;&amp;
		modus_utils.is_empty(inSF.other.recType) ) {
			modus_utils.checkObj(inSF.local.recType, false , false);
			modus_utils.checkObj(inSF.overseas.recType, false , false);
			modus_utils.checkObj(inSF.other.recType, false , false);
			errCnt++;	
	}
	
	return errCnt;
	
}

function setSignatories() {

	//â€¢	If only 1 type is selected (Add/Update/Remove) â€“ rules is in place
	//â€¢	If more than 1 type is selected (Add/Update/Remove) â€“ same as current.
	
	//Rules:
	//add/update - Can select all (no change)
	
	//Remove -  â€œTo update â€¦â€ Ie only can select â€œTo replaceâ€¦â€
	
	//updSignature.sfSignature.dtls.Table1.Row1.chgReq.recType
	var i;
	var node;
	var option = null;
	for (i=0;i&lt;updSignature.sfSignature.dtls.Table1._Row1.count;i++) {
		//updSignature.sfSignature.dtls.Table1.Row1.chgReq.recType.del
		node = xfa.resolveNode("updSignature.sfSignature.dtls.Table1.Row1[" + i + "].tblDtls.fieldDtls");
		//updSignature.sfSignature.dtls.Table1.Row1.tblDtls.fieldDtls.chgReq.recType.update
		if (!modus_utils.is_empty(node.chgReq.recType)) {
			if (option == null) {
				option = node.chgReq.recType.rawValue;
			} else {
				//second option found
				option = "9";
				break;
			}
		}
	}
	
	
	//dec 2020 - Show existing for REMOVE mode
	//updSignature.sfSignature.dtls.signConditions.existing.presence = "visible";
	updSignature.sfSignature.dtls.signConditions.sfUpdate.presence = "visible";
	//if (option == "2") {
	//	//
	//	updSignature.sfSignature.dtls.signConditions.existing.presence = "hidden";
	//	if (updSignature.sfSignature.dtls.signConditions.existing.rawValue == "1") {
	//		updSignature.sfSignature.dtls.signConditions.existing.rawValue = "0";
	//		modus_local.checkSignCondition();
	//	}
	//} else 
	if (option == "3") {
		//
		//updSignature.sfSignature.dtls.signConditions.existing.presence = "hidden";
		//if (updSignature.sfSignature.dtls.signConditions.existing.rawValue == "1") {
		//	updSignature.sfSignature.dtls.signConditions.existing.rawValue = "0";
		//	modus_local.checkSignCondition();
		//}
		updSignature.sfSignature.dtls.signConditions.sfUpdate.presence = "hidden";
		if (updSignature.sfSignature.dtls.signConditions.sfUpdate.update.rawValue == "1") {
			updSignature.sfSignature.dtls.signConditions.sfUpdate.update.rawValue = "0";
			modus_local.checkSignCondition();
		}
	} else {
		//all vislble
	}
}


function setCurr( inSF ) {

	//inSF = updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix
	
	//this update and set the currency of ALL the rows
	
	var rtnArr = [0,""];    //first value return is the row instanceIndex where the currency code first is found, the second value is the actual code in this field
	
	var i;
	var node;
	var found = false;
	for (i=0;i&lt;inSF._amtLine.count;i++) {
		node = inSF.resolveNode("amtLine[" + i + "]");
		if (node.range.rawValue == "0") {
			//no currency
			modus_utils.removeBorderColor(node.curr,false);
			node.curr.access = "protected";
			node.curr.rawValue = ""
			modus_utils.removeBorderColor(node.amt,false);
			node.amt.access = "protected";
			node.amt.rawValue = "";
		} else {
			
			node.amt.access = "open";
			//found
			if (found) {
				modus_utils.removeBorderColor(node.curr,false);
				node.curr.access = "protected";
				node.curr.rawValue = rtnArr[1];
			} else {
				found  = true;
				node.curr.access = "open";
				rtnArr[0] = i;
				rtnArr[1] = node.curr.rawValue;
			}
		}	
	}
	
	return rtnArr;

}

function validateMatrix( inSF ) {

	//inSF = updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix
	
	var errCnt = 0
	var i;
	var nodeI;
	var j;
	var nodeJ;
	
	var validateGroup = checkGroupMandatory();
	
	for (i=0;i&lt;inSF._amtLine.count;i++) {
		nodeI = inSF.resolveNode("amtLine[" + i + "]");
		
		errCnt +=  modus_utils.checkObj( nodeI.range , false , false);
		
		if (nodeI.range.rawValue != "0") {
			errCnt +=  modus_utils.checkObj( nodeI.curr, false , false);   //updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.amtLine.curr
			errCnt +=  modus_utils.checkObj( nodeI.amt, false , false);	//updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.amtLine.amt
		}
		
		for (j=0;j&lt;nodeI.grouping._group.count;j++) {
			nodeJ = nodeI.resolveNode("grouping.group[" + j + "]");
			
			if (j!=0) {
				errCnt +=  modus_utils.checkObj( nodeJ.andOr , false , false);
			}
			errCnt +=  modus_utils.checkObj( nodeJ.userNum, false , false);  //updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.amtLine.grouping.group.userNum
			if (updSignature.sfSignature.dtls.authGroups.option.rawValue != "1") {
				//check only if the company uses grouping
				if (validateGroup) {
					errCnt +=  modus_utils.checkObj( nodeJ.groupNum, false , false);	//updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.amtLine.grouping.group.groupNum
				}
			}
			
		}
	
	}
	return errCnt;
}


function getMatrixText( inSF , printMode ) {

	//inSF = updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix
	//printmode also use when locking the form
	//the text should be show smae as priting the form
	var rtnString = "";
	
	if (inSF == null) {
		if (updSignature.sfSignature.dtls.signConditions.existing.rawValue == "1") {
			return "As per existing records";
		} else if (updSignature.sfSignature.dtls.signConditions.sfReplace.replace.rawValue == "1" &amp;&amp; updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions.rawValue == "1") {
			return "To replace existing records with the following condition:\n    Singly";
		} else if (updSignature.sfSignature.dtls.signConditions.sfReplace.replace.rawValue == "1" &amp;&amp; updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions.rawValue == "2") {
			return "To replace existing records with the following condition:\n    Any Two";			
		} else if (updSignature.sfSignature.dtls.signConditions.sfReplace.replace.rawValue == "1" &amp;&amp; updSignature.sfSignature.dtls.signConditions.sfReplace.repalceOptions.rawValue == "3") {
			rtnString = "To replace existing records with the following condition:\n";
			if (updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.attached.rawValue == "1") {
				rtnString += "    Refer to attached signing conditions (signed by Authorised Persons)";
				return rtnString;
			} else {
				inSF  = updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix;
			}
		} else if (updSignature.sfSignature.dtls.signConditions.sfUpdate.update.rawValue == "1" &amp;&amp; updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions.rawValue == "1") {
			return "To update for signatories indicated above with the following condition:\n    Singly";
		} else if (updSignature.sfSignature.dtls.signConditions.sfUpdate.update.rawValue == "1" &amp;&amp; updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions.rawValue == "2") {
			return "To update for signatories indicated above with the following condition:\n    Any Two";
		} else if (updSignature.sfSignature.dtls.signConditions.sfUpdate.update.rawValue == "1" &amp;&amp; updSignature.sfSignature.dtls.signConditions.sfUpdate.updateOptions.rawValue == "3") {
			rtnString = "To update for signatories indicated above with the following condition:\n";
			if (updSignature.sfSignature.dtls.signConditions.sfUpdate.authMatrix.attached.rawValue == "1") {
				rtnString += "    Refer to attached signing conditions (signed by Authorised Persons)";
				return rtnString;
			} else {
				inSF  = updSignature.sfSignature.dtls.signConditions.sfUpdate.authMatrix;
			}
		} else {
			if (printMode) {
				//assume print blank
				rtnString += "\n";
				rtnString +=  "For Amounts ________________________ ";
				rtnString += "\n";
				rtnString += "\n";
				rtnString += "    Group ___ (If applicable) : Any ____ to sign";
				rtnString += "\n";
				return rtnString;
			} else {
				return "";
			}
		}
	}

	var i;
	var nodeI;
	var j;
	var nodeJ;
	
	
	var carriageReturn = "";
	
	for (i=0;i&lt;inSF._amtLine.count;i++) {
		nodeI = inSF.resolveNode("amtLine[" + i + "]");
		
		rtnString += carriageReturn;
		carriageReturn = "\n\n";
	
		switch (nodeI.range.rawValue) {
			case "0":
				rtnString += "    For any Amount ";
				break;
			case "1":
				rtnString += "    For Amounts Equal to ";
				break;
			case "2":
				rtnString += "    For Amounts Equal to &amp; More than ";
				break;
			case "3":
				rtnString += "    For Amounts Equal to &amp; Less than ";
				break;			
			case "4":
				rtnString += "    For Amounts More than ";
				break;
			case "5":
				rtnString += "    For Amounts Less than ";
				break;
		}

		if (nodeI.range.rawValue != "0") {
			rtnString += nodeI.curr.rawValue;
			rtnString += " ";
			rtnString += nodeI.amt.formattedValue;
			//rtnString += " ";
		}
		
		//rtnString += "\n"; //"Any ";
		
		for (j=0;j&lt;nodeI.grouping._group.count;j++) {
			
			nodeJ = nodeI.resolveNode("grouping.group[" + j + "]");
			rtnString += "\n";
			if (j!=0) {
				rtnString += "        ";
				rtnString += nodeJ.andOr.formattedValue; 
				rtnString +=  "\n";   //"";
			}
			
			//console.println("printMode  : " + printMode );
			//if (printMode == true &amp;&amp; modus_utils.is_empty(nodeJ.groupNum)) {
			//Dec 20202 remove the print requirmeent
			if (modus_utils.is_empty(nodeJ.groupNum)) {
				rtnString += "        Any ";
			} else {
				rtnString += "        Group ";
				//if (modus_utils.is_empty(nodeJ.groupNum) ) {
				//	rtnString += "____";
				//} else {
					rtnString += nodeJ.groupNum.rawValue;
				//}
				//if (printMode == true) {
					rtnString += " : Any ";	
				//} else {
				//	rtnString += " (If applicable) : Any ";	
				//}
			}
			rtnString += nodeJ.userNum.formattedValue;   //updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.amtLine.grouping.group.userNum
			
			//if (updSignature.sfSignature.dtls.authGroups.option.rawValue == "1") {
				//no gouping
			//} else {
			//	rtnString += " from GROUP ";
			//	rtnString += nodeJ.groupNum.rawValue;      //updSignature.sfSignature.dtls.signConditions.sfReplace.authMatrix.amtLine.grouping.group.groupNum
			//}
			rtnString += " to sign";
		}
		
		
	
	}
	
	return rtnString ;
}


function setGroup( inSF ) {
	//inSF = updSignature.sfSignature.dtls.Table1.Row1
	
	
		if (updSignature.sfSignature.dtls.authGroups.option.rawValue == "1") {
			inSF.tblDtls.fieldDtls.group.rawValue = "";
			inSF.tblDtls.fieldDtls.group.access = "protected";
			inSF.tblDtls.fieldDtls.group.border.fill.color.value = "225,225,225";
		} else {
			inSF.tblDtls.fieldDtls.group.access = "open";
			inSF.tblDtls.fieldDtls.group.border.fill.color.value = "255,255,255";
		}
	
}

