function isAddressEmpty() {
	
	if ( !modus_utils.is_empty(updBusiness.chgAddress.dtls.busadd)) {return false;}
	if ( !modus_utils.is_empty(updBusiness.chgAddress.dtls.mail)) {return false;}
	if ( !modus_utils.is_empty(updBusiness.chgAddress.dtls.add1)) {return false;}
	if ( !modus_utils.is_empty(updBusiness.chgAddress.dtls.add2)) {return false;}
	if ( !modus_utils.is_empty(updBusiness.chgAddress.dtls.country)) {return false;}
	if ( !modus_utils.is_empty(updBusiness.chgAddress.dtls.postal)) {return false;}
	modus_print.removeBorderSF( updBusiness.chgAddress);
	return true;
}


function checkDuplicateNricContact( inFld ) {
	//inFld is current NRIC to check
	
	var currentInstance = inFld.parent.instanceIndex;   //updContact.contactDtls.dtls.contactP.icNo
	var i;
	var node;													

	for (i=0;i&lt;updContact.contactDtls.dtls._contactP.count;i++) {
 		if (i == currentInstance) {
 			//skip itself
 			continue;
 		}
 		node = xfa.resolveNode( "updContact.contactDtls.dtls.contactP[" + i + "]");
 		if ( node.icNo.rawValue == inFld.rawValue ) {
 			modus_utils.errMsg  = "Duplicate NRIC/Passport No. with Contact Person " + (i+1);
 			modus_utils.changeBorderColorRed(inFld );
 			return 1;	 //error
 		} 		
	}
	
	return 0;   //no error
}

function checkDuplicateNricEalert( inFld ) {
	//inFld is current NRIC to check
	
	var currentInstance = inFld.parent.parent.parent.instanceIndex;   //updEalerts.userDtls.dtls.sfUsers.usr.nameDetails.icNo
	var i;
	var node;													

	for (i=0;i&lt;updEalerts.userDtls.dtls._sfUsers.count;i++) {
 			
 		if (i == currentInstance) {
 			//skip itself
 			continue;
 		}
 		node = xfa.resolveNode( "updEalerts.userDtls.dtls.sfUsers[" + i + "]");
 		if ( node.usr.nameDetails.icNo.rawValue == inFld.rawValue ) {
 			modus_utils.errMsg  = "Duplicate NRIC/Passport No. with User " + (i+1);
 			modus_utils.changeBorderColorRed(inFld );
 			return 1;	 //error
 		} 		
	}
	
	return 0;   //no error
}

function setAddLables( inSF ) {
  if (inSF.addType.rawValue == "1") {
  	//PObox
  	//Feb 2025 change to "Privy Box No"
  	//inSF.lblBlock.value.text.value = "PO Box No";
  	//inSF.lblBuilding.value.text.value = "";
  	inSF.privySF.presence = "visible";
  	inSF.landedSF.presence = "hidden";
  	inSF.buildingSF.presence = "hidden";
  	inSF.block.parent.presence = "hidden";
  	
  	//modus_color.colorStorey("protected", inSF.storey);
  	//modus_color.colorUnit("protected", inSF.unit);
  } else if (inSF.addType.rawValue == "3") {
  
  	inSF.privySF.presence = "hidden";
  	inSF.landedSF.presence = "visible";
  	inSF.buildingSF.presence = "hidden";
  	inSF.block.parent.presence = "hidden";
  } else {
  	inSF.privySF.presence = "hidden";
  	inSF.landedSF.presence = "hidden";
  	inSF.buildingSF.presence = "visible";
  	inSF.block.parent.presence = "hidden"
   }

}


function singleCorpSMS( inSF ) {
	//set other SF to unselect Corp SMS, only 1 can eb selected
	var i=0;
	var node;
	var icNumber;
	for (i=0;i&lt;updContact.contactDtls.dtls._contactP.count;i++) {
 		node = xfa.resolveNode( "updContact.contactDtls.dtls.contactP[" + i + "]");
 		if (i==inSF.instanceIndex) {
 			//save IC number
 			icNumber =  node.icNo.rawValue;
 		} else {
 			node.options.atmSms.selected.rawValue = "0";
 		}
 	}

 	if (Main.options.dtls.eService.rawValue == "1") {
 		//can only check for the same user, uise NRIC nunumber
 		for (i=0;i&lt;updEalerts.userDtls.dtls._sfUsers.count;i++) {
 			node = xfa.resolveNode("updEalerts.userDtls.dtls.sfUsers[" + i + "]");
			if (node.sfSms.title.sms.rawValue == "1" ) {
				//check if same IC
				//console.println("icNumber : " +  icNumber + " node.usr.nameDetails.icNo.rawValue: " + node.usr.nameDetails.icNo.rawValue);
				if (icNumber != node.usr.nameDetails.icNo.rawValue || modus_utils.is_empty(node.usr.nameDetails.icNo)){
					//remvoe the option
					//console.println("start remove");
					node.sfSms.title.sms.rawValue = "0";
					node.sfSms.title.sms.execInitialize();
				}
				break;
			}	
  		}
 	}
 	
 }
	
function singleVeloPrimaryContact( inSF ) {
	//set other SF to unselect Corp SMS, only 1 can eb selected
	var i=0;
	var node;
	for (i=0;i&lt;updContact.contactDtls.dtls._contactP.count;i++) {
 		node = xfa.resolveNode( "updContact.contactDtls.dtls.contactP[" + i + "]");
 		if (i==inSF.instanceIndex) {
 			//skip
 		} else {
 			//updContact.contactDtls.dtls.contactP.options.primaryContact.selected
 			//node.options.primaryContact.selected.rawValue = "0";
 			//modus_color.setPrimary( node.options.primaryContact ); 
 		}
 	}
 }
 
 function singleUserCorpSms( inSF ) {
	//set other SF to unselect Corp SMS, only 1 can eb selected
	var i=0;
	var node;
	var icNumber;
	for (i=0;i&lt;updEalerts.userDtls.dtls._sfUsers.count;i++) {
 		node = xfa.resolveNode("updEalerts.userDtls.dtls.sfUsers[" + i + "]");
 		if (i==inSF.instanceIndex) {
 			//save IC number
 			icNumber =  node.usr.nameDetails.icNo.rawValue;
  		} else {
 			//updContact.contactDtls.dtls.contactP.options.primaryContact.selected
 			node.sfSms.title.sms.rawValue = "0";
 			node.sfSms.title.sms.execInitialize();
  		}
 	}
 	
 	if (Main.options.dtls.contractDtls.rawValue == "1") {
	 	for (i=0;i&lt;updContact.contactDtls.dtls._contactP.count;i++) {
	 		node = xfa.resolveNode( "updContact.contactDtls.dtls.contactP[" + i + "]");
	 		if (node.options.atmSms.selected.rawValue == "1") {
	 			//check if same IC
				//console.println("icNumber : " +  icNumber + " node.usr.nameDetails.icNo.rawValue: " + node.usr.nameDetails.icNo.rawValue);
				if (icNumber != node.icNo.rawValue || modus_utils.is_empty(node.icNo)){
					//remvoe the option
					//console.println("start remove");
					node.options.atmSms.selected.rawValue = "0";
				}
				break;
	 		}
	  	}
	 }
 }
 
 function checkSGpostal( inFld) {
 	var errCnt = 0;
 	errCnt = modus_utils.checkObj( inFld, false, false);
 	
 	if (errCnt == 0) {
 		if ( inFld.rawValue.length != 6 ) {
 			modus_utils.errMsg = "Must be 6 digits";
 			modus_utils.changeBorderColorRed(inFld); 
 			errCnt++;
 		}
 	}
 	
 	return errCnt;
 }
 
 function seteAlertLayout( inSF ) {  //inSF = updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls
 	//console.println("seteAlertLayout:" +  inSF.somExpression );
 	
 	modus_print.removeBorderSF ( inSF );
 	
 	switch (inSF.selection.recType.rawValue) {
	 	case "1":
	
	 		//inSF.userAccount.presence = "visible";   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.userAccount.recType.user
	 		modus_color.colorUserAccount(inSF.userAccount, "open");
	 		//inSF.accDetails.presence = "visible";
	 		modus_color.colorAccDetails(inSF.accDetails, "open");
	 		
	 		//inSF.accDetails.sfLeft.cashDetails.options.presence = "visible";	
	 		
	 		
	 		if (inSF.accDetails.sfLeft.cash.rawValue == "1") {
	 			//inSF.accDetails.sfLeft.cashDetails.presence = "visible";	
	 			modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "open");
	 			modus_color.colorCash(inSF.accDetails.sfLeft.cashDetails, "open");
	 			
	 			//inSF.accDetails.sfRight.presence = "visible";
	 			modus_color.colorFunds(inSF.accDetails.sfRight, "open");
	 				
	 		} else {
				//inSF.accDetails.sfLeft.cashDetails.presence = "hidden";	
				modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "protected");
				modus_color.colorCash(inSF.accDetails.sfLeft.cashDetails, "protected");
				
				//inSF.accDetails.sfRight.presence = "hidden";	
				modus_color.colorFunds(inSF.accDetails.sfRight, "protected"); 		
	 		}
	 		//inSF.optFeature.presence = "visible";
	 		modus_color.colorOptFeatures(inSF.optFeature, "open"); 		
	 		break;
	 	case "2":
	 		
	 		//inSF.userAccount.presence = "visible";
	 		modus_color.colorUserAccount(inSF.userAccount, "open");
	 		
	 		//inSF.accDetails.sfLeft.cashDetails.options.presence = "hidden";	
			modus_color.colorCash(inSF.accDetails.sfLeft.cashDetails, "protected");
				
	 		//inSF.accDetails.sfRight.presence = "hidden";	
	 		modus_color.colorFunds(inSF.accDetails.sfRight, "protected"); 			
	 		if (inSF.userAccount.recType.rawValue == "1") {   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.cash
	 			//user
	 			//inSF.accDetails.presence = "hidden";
	 			modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "protected");
	 			modus_color.colorAccDetails(inSF.accDetails, "protected");
	 		} else if (inSF.userAccount.recType.rawValue == "2") {
	 			//acount
	 			//inSF.accDetails.presence = "visible";
	 			modus_color.colorAccDetails(inSF.accDetails, "open");	
	 			if (inSF.accDetails.sfLeft.cash.rawValue == "1") {
	 				modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "open");
	 			} else {
	 				modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "protected");
	 			}
	 		} else {
		 		//inSF.accDetails.presence = "hidden";
		 		modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "protected");
		 		modus_color.colorAccDetails(inSF.accDetails, "protected");
	 		}
			//inSF.optFeature.presence = "hidden";
			modus_color.colorOptFeatures(inSF.optFeature, "protected"); 	
	 		break;
	 	case "3":
	 		//inSF.userAccount.presence = "invisible";
	 		modus_color.colorUserAccount(inSF.userAccount, "protected");
	 		//inSF.accDetails.presence = "visible";
	 		modus_color.colorAccDetails(inSF.accDetails, "open");
	 		
	 		
	 		if (inSF.accDetails.sfLeft.cash.rawValue == "1") {    //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.cash
	 			//inSF.accDetails.sfLeft.cashDetails.presence = "visible";
	 			modus_color.colorCash(inSF.accDetails.sfLeft.cashDetails, "open");
	 			modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "open");
	 			//inSF.accDetails.sfRight.presence = "visible";
	 			modus_color.colorFunds(inSF.accDetails.sfRight, "open"); 			
	 		} else {
	 			//inSF.accDetails.sfLeft.cashDetails.presence = "hidden";
	 			modus_color.colorCash(inSF.accDetails.sfLeft.cashDetails, "protected");
	 			modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "protected");
				//inSF.accDetails.sfRight.presence = "hidden";	 		
				modus_color.colorFunds(inSF.accDetails.sfRight, "protected"); 		
	 		}
	 		//inSF.optFeature.presence = "visible";
	 		modus_color.colorOptFeatures(inSF.optFeature, "open");
	 		break;
	 	default:
	 		//inSF.userAccount.presence = "invisible";
	 		modus_color.colorUserAccount(inSF.userAccount, "protected");
	 		//inSF.accDetails.presence = "hidden";
	 		modus_color.colorAccount(inSF.accDetails.sfLeft.cashDetails, "protected");
	 		modus_color.colorCash(inSF.accDetails.sfLeft.cashDetails, "protected");
	 		//inSF.optFeature.presence = "hidden";
	 		modus_color.colorOptFeatures(inSF.optFeature, "protected");
	 		
	 		
	 		modus_color.colorFunds(inSF.accDetails.sfRight, "protected"); 
	 		modus_color.colorAccDetails(inSF.accDetails, "protected"); 
 	}
 
 }
 
 function checkPhoneCode(inFld) {
 
  var errCnt = 0;
  
  errCnt += modus_utils.checkObj( inFld, false , false);
  
  if (errCnt == 0 ) {
  	if ((inFld.rawValue.length != 7) &amp;&amp; (inFld.rawValue.length != 8)) {
  		errCnt++
  		modus_utils.errMsg = 'PhoneBanking code must be 7 or 8 digits';
  		modus_utils.changeBorderColorRed(inFld);
  	}
  }
  
  return errCnt;
 }
 
 
 function checkContactPersonOption( inSF ) {
	//when update contact person at least 1 of the 3 options must be selected
	//console.println(inSF.somExpression );
	if (modus_utils.is_empty(inSF.options.authContact.selected) &amp;&amp;
		modus_utils.is_empty(inSF.options.updateVelo.update) &amp;&amp;  //updContact.contactDtls.dtls.contactP.options.updateVelo.update
		modus_utils.is_empty(inSF.options.atmSms.selected) ) {
		 modus_utils.checkObj( inSF.options.authContact.selected, false , false);
		 modus_utils.checkObj( inSF.options.updateVelo.update, false , false);
		 modus_utils.checkObj( inSF.options.atmSms.selected, false , false);		 
		return 1;
	} else {
		modus_utils.removeCheckBoxColorRed(inSF.options.authContact.selected);
		modus_utils.removeCheckBoxColorRed(inSF.options.updateVelo.update);
		modus_utils.removeCheckBoxColorRed(inSF.options.atmSms.selected);
	}
	return 0;
}

function checkSMSoption( inSF ) {
	if (modus_utils.is_empty(inSF.local) &amp;&amp;
		modus_utils.is_empty(inSF.overseas) &amp;&amp;
		modus_utils.is_empty(inSF.other) ) {
		 modus_utils.checkObj( inSF.local, false , false);
		 modus_utils.checkObj( inSF.overseas, false , false);
		 modus_utils.checkObj( inSF.other, false , false);
		 return 1;
	} else {
		modus_utils.removeCheckBoxColorRed( inSF.local, false , false);
		modus_utils.removeCheckBoxColorRed( inSF.overseas, false , false);
		modus_utils.removeCheckBoxColorRed( inSF.other, false , false);
	}
	

	return 0;	
}


function checkPhones( inSF ) {
	//at lest phone or mobile is required
	//console.println(inSF.somExpression);
	var errCnt = 0;
	
	if (inSF.recOption.rawValue == "3") {
		//remove
		//both numbers optional
		errCnt += modus_local.checkPhone(inSF.phone, false, false);
		errCnt += modus_local.checkPhone(inSF.mobile, false, false);
	} else {
	
		modus_utils.removeBorderColor(inSF.phone.cntry, false); 
	 	modus_utils.removeBorderColor(inSF.phone.area, false);
	 	modus_utils.removeBorderColor(inSF.phone.contact, false);
	 	modus_utils.removeBorderColor(inSF.mobile.cntry, false);
	 	modus_utils.removeBorderColor(inSF.mobile.area, false);
	 	modus_utils.removeBorderColor(inSF.mobile.contact, false);
		
		if ( modus_utils.is_empty(inSF.phone.cntry) &amp;&amp; 
			modus_utils.is_empty(inSF.phone.area) &amp;&amp;
			modus_utils.is_empty(inSF.phone.contact) &amp;&amp;
			modus_utils.is_empty(inSF.mobile.cntry) &amp;&amp;
			modus_utils.is_empty(inSF.mobile.area) &amp;&amp;
			modus_utils.is_empty(inSF.mobile.contact) ) {
				//console.println("required");
				modus_local.checkPhone(inSF.phone, false, true);
				modus_local.checkPhone(inSF.mobile, false, true);
				errCnt = errCnt + 4;
		} else {
			//console.println("optionl");
			errCnt += modus_local.checkPhone(inSF.phone, false, false);
			errCnt += modus_local.checkPhone(inSF.mobile, false, false);  //updContact.contactDtls.dtls.contactP.mobile.cntry
		}
	}
	
	if (errCnt == 0) {
		//for eAlert the mobilennumber must be start with 65
		if (!modus_utils.is_empty(inSF.mobile.cntry) ||
			!modus_utils.is_empty(inSF.mobile.area) ||
			!modus_utils.is_empty(inSF.mobile.contact) ) {
			if ((inSF.recOption.rawValue == "2") &amp;&amp; (inSF.options.updateVelo.update.rawValue == "1") &amp;&amp; (inSF.mobile.cntry.rawValue != "65")) {
				//update only
				modus_utils.errMsg = "Only Singapore numbers (Country Code '65') can be used for eAlert@ocbc";
				modus_utils.changeBorderColorRed(inSF.mobile.cntry);
				errCnt++;
			} 
		}	
	}
	
	
	return errCnt;
	
}


function checkPhonesSig( inSF ) {
	//at lest phone or mobile is required
	//console.println(inSF.somExpression);
	var errCnt = 0;
	
	if (inSF.chgReq.recType.rawValue == "3") {   //updSignature.sfSignature.dtls.Table1.Row1.chgReq.recType.del
