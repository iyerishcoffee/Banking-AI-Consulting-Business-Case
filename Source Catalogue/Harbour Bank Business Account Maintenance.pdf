</script></event><field name="clear" w="18mm" h="4mm" relevant="-print" x="36.999mm" y="1.253mm"><ui><button highlight="none"/></ui><font typeface="Adobe Arabic"/><caption><value><text>Clear Signature</text></value><para vAlign="middle" hAlign="center"/><font size="7pt" typeface="Myriad Pro" weight="bold"><fill><color value="255,255,255"/></fill></font></caption><border hand="right"><edge presence="hidden"/><fill><color value="51,51,51"/></fill><corner presence="hidden" thickness="0.176mm" join="round" radius="5px"/></border><bind match="none"/><assist><toolTip>This will clear your signature and unlock this form</toolTip></assist><validate><script contentType="application/x-javascript">
 //console.println("nameDate0.validate");

 if (ImageField1.rawValue == null || ImageField1.rawValue.length == 0 ) {
 	this.presence = "hidden";
 	lblSigClick1.presence = "visible";
 	lblSigClick1.relevant = "-print";

 } else {
 	
 	if (auditor.access == "protected") { 
 		//skip
 	} else {
 		var errCnt = modus_validate.validatePage1()
	 	var errCnt = errCnt + modus_validate.validateForm();
	 	var errCntName = modus_utils.checkObj( auditor, false, false);
		//var errcntDate = modus_local.validateDate( signDate.date, false, true);
		var errcntDate = modus_local.validateSignDate( signDate.date, false);
		
		if (errCnt == 0 &amp;&amp; errCntName != 0 &amp;&amp; errcntDate == 0 ) {
			//missing Sign name, ask for it.
			var promptName = xfa.host.response("What is the Name of Authorised Signatory?","Name of Authorised Signatory","",false);
			if (promptName == null || promptName == "") {
				//skip
			} else {
				auditor.rawValue = promptName;
				modus_utils.removeBorderColor(auditor,false);
				errCntName = 0;
			}
		} 	
	 	errCnt = errCnt + errCntName + errcntDate;
	 	
		if (errCnt != 0) {
			ImageField1.rawValue = null;
			
			this.presence = "hidden";
	 		lblSigClick1.presence = "visible";
	 		lblSigClick1.relevant = "-print";
	 		
			xfa.host.messageBox("Oops!\n\nPlease check that the details are correct before signing this document", "Validation Error", 1, 0);
		} else {
 
		 	if (Main.options.dtls.signature.rawValue == "1") {
				modus_local.showSignDesc( 0, true);  //different text on actual locak form
 			}
 		
			modus_print.removeBorderSF (Main);
			if (updSignature.presence == "visible") {
				modus_print.removeBorderSF (updSignature);
			}
			if (updContact.presence == "visible") {
				modus_print.removeBorderSF (updContact);
			}
			if (updBusiness.presence == "visible") {
				modus_print.removeBorderSF (updBusiness);
			}
			if (updDnc.presence == "visible") {	
				modus_print.removeBorderSF (updDnc);
			}
			if (updEalerts.presence == "visible") {
				modus_print.removeBorderSF (updEalerts);
			}
								
			//console.println("ImageField2.rawValue : " + ImageField2.rawValue);
			if (ImageField2.rawValue == null || ImageField2.rawValue.length == 0 ) {
	 			this.presence = "visible";
		 		this.relevant = "-print";
		 	} else {	
		 		this.presence = "hidden";
		 	}
		 	lblSigClick1.presence = "invisible";
		 	
		 	modus_local.lockForm( "protected" );
			auditor.access = "protected";
			signDate.date.access = "protected";
			ImageField1.access = "protected";
			modus_local.setCurrentDate(signDate.date);
		}
	}
 }
 true;
 	
 	
</script></validate><event activity="click" name="event__click"><script contentType="application/x-javascript">		
	ImageField1.rawValue = null;
	modus_local.lockForm ( "open" );
	
	
	//update the auth text
	if (Main.options.dtls.signature.rawValue == "1") {
		modus_local.showSignDesc( 0, false);  
 	}
 	
	auditor.access = "open";
   	auditor.rawValue = "";
   	
   	signDate.date.access = "open";
   	signDate.date.dateDD.rawValue = "";
   	signDate.date.dateMM.rawValue = "";
   	signDate.date.dateYY.rawValue = "";
   	
   	ImageField1.access = "open";
   	
   	
   	modus_utils.removeBorderColor(nameDate1.auditor, false)
   	modus_utils.removeBorderColor(nameDate2.auditor, false)
</script></event></field><?templateDesigner expand 0?></subform><subform x="63mm" y="20.001mm" w="56.998mm" h="20.06mm" name="nameDate1"><bind match="none"/><subform y="9mm" name="signDate"><subform y="6.31mm" name="lineDay"><bind match="none"/><draw name="left" x="0mm" w="0in" h="1.75mm" y="0mm"><value><line><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="bottom" x="0mm" y="1.75mm" w="7mm" h="0pt"><value><line><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="right" x="7.001mm" w="0in" h="1.75mm" y="0mm"><value><line slope="/"><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="L170" x="3.499mm" y="0.5mm" w="0pt" h="1.25mm"><value><line slope="/"><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><?templateDesigner expand 0?></subform><subform x="10.499mm" y="6.31mm" name="lineMonth"><bind match="none"/><draw name="left" w="0in" h="1.75mm" y="0mm"><value><line><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="bottom" x="0.002mm" y="1.75mm" w="7mm" h="0in"><value><line><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="right" x="7mm" w="0in" h="1.75mm" y="0mm"><value><line slope="/"><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="L172" x="3.5mm" y="0.5mm" w="0in" h="1.25mm"><value><line slope="/"><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><?templateDesigner expand 0?></subform><subform x="20.999mm" y="6.31mm" name="lineYear"><bind match="none"/><draw name="left" w="0in" h="1.75mm" y="0mm" x="0mm"><value><line><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="bottom" x="0.002mm" y