//console.println("formattedPhone::validate");
var tmpString = ""; 
 if ( !modus_utils.is_empty(Main.corpInfo.dtls.phone.cntry) ) {
 	tmpString += "+" ;
 	tmpString += Main.corpInfo.dtls.phone.cntry.rawValue ;
 } 
  if ( !modus_utils.is_empty(Main.corpInfo.dtls.phone.area) ) {
 	if (tmpString != "") {
 		tmpString  += "-" ;
 	}
 	tmpString  += Main.corpInfo.dtls.phone.area.rawValue;
 }
 if ( !modus_utils.is_empty(Main.corpInfo.dtls.phone.contact) ) {
 	if (tmpString != "") {
 		tmpString  += "-" ;
 	}
 	tmpString  += Main.corpInfo.dtls.phone.contact.rawValue;
 }
 
  if ( !modus_utils.is_empty(Main.corpInfo.dtls.mobile.cntry) ) {
 	if (tmpString != "") {
 		tmpString  += " or " ;
 	}
 	tmpString  += "+" ;
 	tmpString  += Main.corpInfo.dtls.mobile.cntry.rawValue;
  }
  if ( !modus_utils.is_empty(Main.corpInfo.dtls.mobile.area) ) {
 	if (tmpString != "") {
 		tmpString  += "-" ;
 	}
 	tmpString  += Main.corpInfo.dtls.mobile.area.rawValue;
  }
  if ( !modus_utils.is_empty(Main.corpInfo.dtls.mobile.contact) ) {
 	if (tmpString != "") {
 		tmpString  += "-" ;
 	}
 	tmpString  += Main.corpInfo.dtls.mobile.contact.rawValue;
  }
  this.rawValue = tmpString  ;
  true;
  
</script></validate></field><field name="recOption" y="14.651mm" x="126.819mm" w="22mm" h="4.5mm" presence="hidden"><ui><checkButton size="2.8222mm" mark="check"><border><edge thickness="0.25mm"><color value="102,102,102"/></edge><corner thickness="0.25mm"><color value="102,102,102"/></corner></border></checkButton></ui><font typeface="Myriad Pro"/><margin leftInset="0mm" rightInset="0mm"/><para vAlign="middle"/><value><integer>0</integer></value><caption reserve="18mm" placement="right"><para vAlign="middle"/><font typeface="Myriad Pro" size="8pt"/><value><text>for function </text></value></caption><items><integer>1</integer><integer>0</integer><integer>2</integer></items><assist><speak disable="1"/></assist><bind match="none"/><event activity="initialize" name="event__initialize"><script contentType="application/x-javascript">
