ginRight="0pt" vAlign="middle"/></draw></subform><draw name="lblAuditor" x="0mm" w="35.483mm" h="4.5mm" y="0.999mm"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="text-decoration:none;letter-spacing:0in">Name of Authorised<span style="xfa-spacerun:yes">Â </span><span style="text-decoration:none">Person</span></p></body></exData></value><ui><textEdit/></ui><para vAlign="middle"/><font size="8pt" typeface="Myriad Pro"><fill><color value="51,51,51"/></fill></font><assist><speak disable="1"/></assist></draw><subform y="7.249mm" name="linAuditor"><bind match="none"/><draw name="left" x="0.148mm" w="0pt" h="1.75mm" y="0mm"><value><line><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="bottom" x="0.052mm" y="1.75mm" w="55mm" h="0in"><value><line slope="/"><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><draw name="right" x="55.052mm" w="0in" h="1.75mm" y="0mm"><value><line><edge thickness="0.1753mm" cap="butt"><color value="102,102,102"/></edge></line></value></draw><?templateDesigner expand 1?></subform><field name="auditor" y="5.499mm" x="0mm" h="3.5mm" w="55mm"><ui><textEdit hScrollPolicy="off"><border presence="hidden"><?templateDesigner StyleID aped0?></border><margin/></textEdit></ui><font typeface="Myriad Pro" size="0pt"/><margin topInset="0mm" bottomInset="0mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><assist><speak disable="1"/></assist><value><text maxChars="80"/></value><keep intact="contentArea"/><event activity="change" name="event__change"><script contentType="application/x-javascript"> 
