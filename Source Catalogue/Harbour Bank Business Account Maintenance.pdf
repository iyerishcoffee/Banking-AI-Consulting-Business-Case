	if (modus_utils.is_empty(Main.options.dtls.signature) &amp;&amp;
		modus_utils.is_empty(Main.options.dtls.contractDtls) &amp;&amp;
		modus_utils.is_empty(Main.options.dtls.businessDtls) &amp;&amp;
	//	modus_utils.is_empty(Main.options.dtls.dnc) &amp;&amp;
		modus_utils.is_empty(Main.options.dtls.eService) ) { 
		 modus_utils.checkObj( Main.options.dtls.signature, false , false);
		 modus_utils.checkObj( Main.options.dtls.contractDtls, false , false);
		 modus_utils.checkObj( Main.options.dtls.businessDtls, false , false);
		// modus_utils.checkObj( Main.options.dtls.dnc, false , false);
		 modus_utils.checkObj( Main.options.dtls.eService, false , false);
		 
		return 1;
	} else {
		modus_utils.removeCheckBoxColorRed(Main.options.dtls.signature);
		modus_utils.removeCheckBoxColorRed(Main.options.dtls.contractDtls);
		modus_utils.removeCheckBoxColorRed(Main.options.dtls.businessDtls);
		//modus_utils.removeCheckBoxColorRed(Main.options.dtls.dnc);
		modus_utils.removeCheckBoxColorRed(Main.options.dtls.eService);
	}
	return 0;
}


