		//}
		
		//if (Main.options.dtls.contractDtls.rawValue  == "1") {
		//	updContact.contactDtls.dtls.bcContactDetails.rawValue = modus_local.getBcContacts().slice(0,-1);
		//	updContact.barCode.PaperFormsBarcode1.rawValue = manualBC.setBarCode( contactBarcode );
		//	updContact.barCode.presence = "visible";
		//}
		
		if (Main.options.dtls.businessDtls.rawValue == "1") {
			updBusiness.barCode.PaperFormsBarcode1.rawValue = manualBC.setBarCode( businessBarcode );
			updBusiness.barCode.presence = "visible";
		}	
		
		if (Main.options.dtls.dnc.rawValue  == "1") {
			updDnc.barCode.PaperFormsBarcode1.rawValue = manualBC.setBarCode( dncBarcode );
			updDnc.barCode.presence = "visible";
		}
		
		//if (Main.options.dtls.eService.rawValue  == "1") {
		//	updEalerts.userDtls.dtls.bcUserDetails.rawValue = modus_local.getBcUsers().slice(0,-1);
		//	updEalerts.barCode.PaperFormsBarcode1.rawValue = manualBC.setBarCode( ealertBarcode );
		//	updEalerts.barCode.presence = "visible";
		//}
	}
		
	modus_print.removeBorderSF( Main );
	modus_print.removeBorderSF( updSignature );
	modus_print.removeBorderSF( updContact );
	modus_print.removeBorderSF( updBusiness);
	modus_print.removeBorderSF( updDnc );
	modus_print.removeBorderSF( updEalerts );
	modus_print.removeBorderSF( signature );
	setUid();
	
	//hide show of channels subform doen in it own pre-rptin and posrt print
	//OCBC16.envelop.presence = "visible";
}
 
 function setUid() {
 
 	//Update UID
	//var inStr = frmName.value;
	//inStr += frmVer.value;
	//inStr += Math.floor(Date.now() / 1000); 
		
	//var outStr = modusSecure.b64_sha1(inStr);
	//outStr = outStr.substring(0,11);  
	Main.hidden.UID.rawValue = modus_local.getCurDateTime();
	
}


function printBlank() {

	var i;
	var node;
	
	if ( Main.auth.accounts._account.count == 0 &amp;&amp; ((Main.options.dtls.signature.rawValue == "1") || (Main.options.dtls.businessDtls.rawValue == "1"))) {
		if (Main.auth.selector.selAccounts.rawValue != "1") {
			Main.auth.accounts._account.setInstances( 6 ) ;
		}
	}
	
	if (Main.options.dtls.signature.rawValue == "1") {
		updSignature.sfSignature.dtls.Table1._Row1.setInstances(4);
	}
	
	if (Main.options.dtls.contractDtls.rawValue == "1") {
		updContact.contactDtls.dtls._contactP.setInstances(2);
		for (i=0;i&lt;updContact.contactDtls.dtls._contactP.count;i++) {
			node = xfa.resolveNode("updContact.contactDtls.dtls.contactP[" + i + "]");
			node.options.existingHead.presence = "visible";
 			node.options.atmSms.presence = "visible";
 			node.options.updateVelo.presence = "visible";		
		}
	}
	
	if (Main.options.dtls.businessDtls.rawValue == "1") {
	
		updBusiness.chgAddress.dtls.Table6.presence = "visible";
 		updBusiness.chgAddress.dtls.Table6.both.presence = "visible";
 		updBusiness.chgAddress.dtls.Table6.dtls.resAdd.presence = "visible";
 		updBusiness.chgAddress.dtls.Table6.dtls.mailAdd.presence = "visible";
 		updBusiness.chgAddress.dtls.Table6.single.presence = "hidden";
 		updBusiness.chgAddress.dtls.Table6.dtls.resAdd.border.presence = "visible";
 		updBusiness.chgAddress.dtls.Table6.dtls.mailAdd.border.presence = "visible";

		updBusiness.natOfBus.presence = "visible";
	}
	
	if (Main.options.dtls.eService.rawValue == "1") {
		updEalerts.userDtls.dtls._sfUsers.setInstances(2);
		for (i=0;i&lt;updEalerts.userDtls.dtls._sfUsers.count;i++) {
			node = xfa.resolveNode("updEalerts.userDtls.dtls.sfUsers[" + i + "]");
			//phone banking
			node.sfPhoneBnk.mainDtls.presence = "visible";
 			node.sfPhoneBnk.dtls.presence = "visible";
 			node.sfPhoneBnk.accounts.presence = "visible";
			node.sfPhoneBnk.accounts._account.setInstances(4);
			
			//eAlerts
			node.sfeAlert.dtls.presence = "visible";
			node.sfeAlert.dtls.userAccount.presence = "visible";
			node.sfeAlert.dtls.accDetails.presence = "visible";
			node.sfeAlert.dtls.optFeature.presence = "visible";
			
			//corp SMS
			node.sfSms.dtls.presence = "visible";
			node.sfSms.dtls.local.amounts.presence = "visible";
			node.sfSms.dtls.overseas.amounts.presence = "visible";
			node.sfSms.dtls.other.amounts.presence = "visible";
			node.note.presence = "visible";
		}
	}
}
</script></event><event activity="postPrint" ref="$host" name="event__postPrint"><script contentType="application/x-javascript">
 modus_utils.specialPrintBlank  = false;
 modus_local.show1Dbarcode = false;
 modus_local.show2Dbarcode = false;
 intro.presence = "visible";
 
 OCBC16.envelop.presence = "hidden";
 updSignature.barCode.presence = "hidden";
 updContact.barCode.presence = "hidden";
 updBusiness.barCode.presence = "hidden";
 updDnc.barCode.presence = "hidden";
 updEalerts.barCode.presence = "hidden";
 
 if ( !modus_utils.is_empty(Main.hidden.UID) ) {
 	Main.hidden.UID.rawValue = "";
 
 	if (Main.options.dtls.signature.rawValue == "1") {
 		//modus_local.showSignDesc( 0, true);  //different text on actual printout
 		if (signature.sig.nameDate0.auditor.access == "protected") { 
 			//skip
 		} else {
			modus_local.showSignDesc( 0, false);  //different text on actual printout
		}
 	}
 }
</script></event><event activity="docReady" ref="$host" name="event__docReady"><script contentType="application/x-javascript">
	var expStatus = modus_local.checkExpDate();
	//console.println("expStatus  : " + expStatus  );
	if ( expStatus == 'E' ) {
		var retn = xfa.host.messageBox(Main.hidden.expMessage.rawValue , "Expired Form", 1 );
		//4 == Yes
		//3 == No
		//2 == Cancel
		intro.access = "protected";
		Main.access = "protected";
		updSignature.access = "protected";
		updContact.access = "protected";
		updBusiness.access = "protected";
		updDnc.access = "protected";
		updEalerts.access = "protected";
		signature.access = "protected";
		envelop.access = "protected";
		
	} else if ( expStatus  == 'W' ) {
		var retn = xfa.host.messageBox(Main.hidden.warnMessage.rawValue , "Expired Form", 1 );
	} else if (modus_validate.verifyBlankForm() ) {
	
 		//xfa.host.messageBox("Here's what you can do:\n\nFill up the form before printing\nPlease ensure your details are correct before printing. If you edit any information, please reprint the form before sending to us. This will reduce the processing time.\n\nOR\n\nPrint it now","",3,0)
 		
 		//keith 11 - Dec - 2020
 		xfa.host.messageBox("Hereâ€™s what you can do:\n\nFill up the form and ensure all details are correct before you input your signature\nOnce signature is provided the form will be locked\nTo unlock to make changes to the form, please clear your signature and sign again after the amendment","",3,0);
 	}  	
</script></event><?templateDesigner Hyphenation excludeInitialCap:1, excludeAllCaps:1, wordCharCnt:7, remainCharCnt:3, pushCharCnt:3?><?templateDesigner expand 1?><?renderCache.subset "Adobe Pi Std" 0 0 UTF-16 2 4 004F?><?renderCache.subset "Arial" 0 0 ISO-8859-1 4 36 9 00030029003700470048004C004F0057005B FTdeiltx?><?renderCache.subset "Courier New" 0 0 ISO-8859-1 4 40 10 0013001400150016001700180019001A001B001C0123456789?><?renderCache.subset "Myriad Pro" 0 0 ISO-8859-1 4 316 87  #$&â€™()*+,-./01234579:;>?@ABCDEFGHILMNOPRSTUVWXYâ€˜abcdefghijklmnopqrstuvwxy{}'â€“â€¢?><?renderCache.subset "Myriad Pro" 1 0 ISO-8859-1 4 284 77 0001000200080009000A000B000D000E000F00100011001200130014001700180019001B0020002100220023002400250026002700280029002A002C002D002E002F00300031003300340035003600370038003A003F00420043004400450046004700480049004A004C004D004E004F0050005100520053005400550056005700580059005A005C005E00690077 !â€™()*,-./0123678:?@ABCDEFGHIKLMNOPRSTUVWY^abcdefghiklmnopqrstuvwxy{}â€œâ€?><?renderCache.subset "Myriad Pro" 0 1 ISO-8859-1 4 264 72 00010005000700080009000A000B000C000D000E000F0010001100120014001600170019001B00210022002300240025002600270028002A002E002F0030003100330034003500360037003A003F004100420043004400450046004700480049004A004C004D004E004F0050005100520053005400550056005700580059005A00680074 $&â€™()*+,-./013568:@ABCDEFGIMNOPRSTUVY^â€˜abcdefghiklmnopqrstuvwxy'â€¢?><?renderCache.subset "Wingdings" 0 0 fontSpecific 4 4 1 000D*?><?renderCache.subset "Wingdings 3" 0 0 fontSpecific 4 4 1 0060}?></subform><?templateDesigner DefaultPreviewDynamic 1?><?templateDesigner WidowOrphanControl 0?><?originalXFAVersion http://www.xfa.org/schema/xfa-template/3.0/?><?templateDesigner Grid show:0, snap:0, units:17, color:ff8080, origin:(0,0), interval:(25000,25000), objsnap:0, guidesnap:0, pagecentersnap:0?><?layout containedExclGroup 1?><?templateDesigner DefaultLanguage JavaScript?><?templateDesigner DefaultRunAt client?><?acrobat JavaScript strictScoping?><?PDFPrintOptions emb