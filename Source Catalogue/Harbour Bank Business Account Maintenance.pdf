neShift="0pt" weight="bold"><fill><color value="39,39,39"/></fill></font><assist><speak disable="1"/></assist><margin bottomInset="2mm" topInset="2mm"/></draw><bind match="none"/><?templateDesigner expand 1?></subform><field name="bcSignatureDetails" h="4mm" w="175.5mm" presence="hidden"><ui><textEdit><border presence="hidden"><?templateDesigner StyleID aped0?></border><margin/></textEdit></ui><font typeface="Myriad Pro" size="9pt"/><margin topInset="0mm" bottomInset="0mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><assist><speak disable="1"/></assist><keep intact="contentArea"/><bind match="global"/><caption><font typeface="Arial" size="8pt"/><para vAlign="middle"/></caption></field><?templateDesigner expand 0?></subform><subform w="187mm" name="barCode" presence="hidden"><bind match="none"/><margin topInset="2mm"/><field name="PaperFormsBarcode1" y="0mm" w="187.029mm" h="35mm" access="readOnly"><ui><barcode type="pdf417" moduleWidth="0.338mm" moduleHeight="0.676mm" errorCorrectionLevel="5"><?templateDesigner decodeMethod 2?><?templateDesigner delimiter '|'?><?templateDesigner manifestRef signBarcode?></barcode></ui><calculate><script contentType="application/x-javascript">//{{Start Generated Content//
