 function changeNumber( str ) {
 	
	var correctedText = "";
	var size = str.length;
	for( var i = 0; i &lt; size; i++ ) {
		var ch = str.charAt( i );
		if( numberBag.indexOf( ch ) != -1 )
			correctedText += ch;
	}
	return correctedText ;
}

