 		//errCnt += modus_utils.checkObj( updBusiness.chgAddress.dtls.options.option , false, false);  //updBusiness.chgAddress.dtls.options.option.newBoth
 		//console.println("after : " + errCnt );
 		if (updBusiness.chgAddress.dtls.options.option.rawValue == "1") {
 			errCnt += checkAddress(updBusiness.chgAddress.dtls.Table6.dtls.resAdd, updBusiness.chgAddress.dtls.Table6.single.resAdd.overseas);
 			errCnt += modus_utils.checkObj( updBusiness.chgAddress.dtls.Table6.both.mailAdd.options.option, false, false);
 			if ( updBusiness.chgAddress.dtls.Table6.both.mailAdd.options.option.rawValue == "2") {
 				errCnt += checkAddress(updBusiness.chgAddress.dtls.Table6.dtls.mailAdd, updBusiness.chgAddress.dtls.Table6.single.mailAdd.overseas);
 			}
 		
 		} else {
	 		if (updBusiness.chgAddress.dtls.options.option.rawValue == "2") {  
	 			errCnt += checkAddress(updBusiness.chgAddress.dtls.Table6.dtls.resAdd, updBusiness.chgAddress.dtls.Table6.single.resAdd.overseas);
 			}
		 	//mail add
		 	if (updBusiness.chgAddress.dtls.options.option.rawValue == "3") {
		 		errCnt += checkAddress(updBusiness.chgAddress.dtls.Table6.dtls.mailAdd, updBusiness.chgAddress.dtls.Table6.single.mailAdd.overseas);
		 	} 		
		 }
		 
		 
 		if ( !modus_utils.is_empty(updBusiness.businessName.dtls.newName)) {
 			errCnt += modus_utils.checkObj (updBusiness.natOfBus.dtls.declare, false , false);	
 		}
 		if (updBusiness.natOfBus.dtls.declare.rawValue == "3") {
 			errCnt += modus_utils.checkObj (updBusiness.natOfBus.dtls.busActivity, false , false);	
 		}
 	}
 	
 //	if (Main.options.dtls.dnc.rawValue == "1") {
		//nothing to check
//	}
	
	if (Main.options.dtls.eService.rawValue == "1") {
		for (i=0;i&lt;updEalerts.userDtls.dtls._sfUsers.count;i++) {
 			node = xfa.resolveNode( "updEalerts.userDtls.dtls.sfUsers[" + i + "]");
 			errCnt += modus_utils.checkObj (node.usr.nameDetails.fullName, false , false);
 			if ( modus_local.checkNric (node.usr.nameDetails.icNo, false , true) ) {
 				errCnt++;
 			} else {
 				errCnt += modus_local.checkDuplicateNricEalert(node.usr.nameDetails.icNo);
 			}
 			//errCnt += modus_utils.checkObj (node.usr.nameDetails.salutation, false , false);
 			
 			errCnt += modus_local.checkPhone(node.usr.nameDetails.contactDtls.mobile, false, true);
 			errCnt += modus_utils.checkObj( node.usr.nameDetails.contactDtls.email, false , false)
 			
 			if (node.sfPhoneBnk.phoneBanking.rawValue == "1") {

 				//errCnt += modus_utils.checkObj (node.sfPhoneBnk.mainDtls.phoneCode, false , false);
 				errCnt += modus_local.checkPhoneCode(node.sfPhoneBnk.mainDtls.phoneCode);
 				errCnt += modus_local.checkPhoneBankSelection( node.sfPhoneBnk.dtls );
 				
 				if (node.sfPhoneBnk.dtls.terminate.rawValue != "1") {  //updEalerts.userDtls.dtls.sfUsers.sfPhoneBnk.dtls.terminate
 					//errCnt += modus_utils.checkObj (node.sfPhoneBnk.dtls.RadioButtonList, false , false);
 				
 					if (node.sfPhoneBnk.dtls.RadioButtonList.rawValue == "2") {  
 						for (j=0;j&lt;node.sfPhoneBnk.accounts._account.count;j++) {
 							nodeJ = node.resolveNode("sfPhoneBnk.accounts.account[" + j + "]");
 							errCnt += modus_utils.checkObj ( nodeJ.recType, false , false);
 							errCnt += modus_local.checkAccNum ( nodeJ.ocbcAcc, true ) ;
 						}
 					}
 				}
 			}
 			if (node.sfeAlert.title.eAlerts.rawValue == "1") {
 				errCnt += modus_utils.checkObj ( node.sfeAlert.dtls.selection.recType , false , false);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.selection.recType.accAccount
 			
 				if (( node.sfeAlert.dtls.selection.recType.rawValue == "1") || ( node.sfeAlert.dtls.selection.recType.rawValue == "2")) {
 					errCnt += modus_utils.checkObj ( node.sfeAlert.dtls.userAccount.recType , false , false);
 				}
 				
 				//if add Or update Or (Delete AND account)
 				if (( node.sfeAlert.dtls.selection.recType.rawValue == "1") || ( node.sfeAlert.dtls.selection.recType.rawValue == "3") || 
 							(( node.sfeAlert.dtls.selection.recType.rawValue == "2") &amp;&amp; (node.sfeAlert.dtls.userAccount.recType.rawValue == "2"))) {
 				
 					if (node.sfeAlert.dtls.accDetails.sfLeft.cash.rawValue == "0" &amp;&amp; node.sfeAlert.dtls.accDetails.sfLeft.eAlert.trade.rawValue == "0") {
 						modus_utils.checkObj (node.sfeAlert.dtls.accDetails.sfLeft.cash , false , false);
 						modus_utils.checkObj (node.sfeAlert.dtls.accDetails.sfLeft.eAlert.trade , false , false);
 						errCnt++;
 					}
 					
 					if (node.sfeAlert.dtls.accDetails.sfLeft.cash.rawValue == "1") {
 						errCnt += modus_local.checkAccNum ( node.sfeAlert.dtls.accDetails.sfLeft.cashDetails.ocbcAcc, true ) ;
 						if (node.sfeAlert.dtls.accDetails.sfLeft.cashDetails.options.presence == "visible") {
 							errCnt += modus_utils.checkObj ( node.sfeAlert.dtls.accDetails.sfLeft.cashDetails.options.lang, false , false);
 							errCnt += modus_utils.checkObj ( node.sfeAlert.dtls.accDetails.sfLeft.cashDetails.options.via, false , false);
 						}
 						if (node.sfeAlert.dtls.accDetails.sfRight.presence == "visible") {
 							errCnt += modus_utils.checkObj ( node.sfeAlert.dtls.accDetails.sfRight.amount, false , false);
 						}
 					}
 					
 				
 				} 				
 
	 			if (node.sfeAlert.dtls.optFeature.presence == "visible")  {
 					if (node.sfeAlert.dtls.optFeature.timeDeposit.rawValue == "1") {
 						errCnt += modus_local.checkAccNum ( node.sfeAlert.dtls.optFeature.ocbcAcc, true);//updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.mode.recType.add
 					}
 				}
 			}
 			if (node.sfSms.title.sms.rawValue == "1") {
 			
 				errCnt += modus_local.checkSMSalert( node.sfSms.dtls );
 				
 				if (node.sfSms.dtls.local.recType.rawValue == "1" || node.sfSms.dtls.local.recType.rawValue == "3" ) {
 					errCnt += modus_utils.checkObj ( node.sfSms.dtls.local.amounts.amts, false , false);
 				}
 				
 				if (node.sfSms.dtls.overseas.recType.rawValue == "1" || node.sfSms.dtls.overseas.recType.rawValue == "3" ) {
 					errCnt += modus_utils.checkObj ( node.sfSms.dtls.overseas.amounts.amts, false , false);
 				}
 				
 				if (node.sfSms.dtls.other.recType.rawValue == "1" || node.sfSms.dtls.other.recType.rawValue == "3" ) {
 					errCnt += modus_utils.checkObj (node.sfSms.dtls.other.amounts.amts , false , false);
 				}
 			}
 		}
 		
 		
 		if ( updEalerts.termination.dtls.debitFees.rawValue == "1") {
 			errCnt += modus_local.checkAccNum (updEalerts.termination.dtls.debitFeesAccount, true);
 		}
 		
 		if (updEalerts.termination.dtls.termEalerts.rawValue == "1") {
 			errCnt += modus_utils.checkObj (updEalerts.termination.dtls.updateOptions, false , false);
 		}
	}
	
	errCnt += modus_local.validateSignDate( signature.sig.nameDate0.signDate.date, false);
	errCnt += modus_local.validateSignDate( signature.sig.nameDate1.signDate.date, false);
	errCnt += modus_local.validateSignDate( signature.sig.nameDate2.signDate.date, false);
					
 	return errCnt;
 
 }
 

 
 //====================
function verifyBlankForm() {
	
	var nameStr;
	var nameStrCurr;
	var j;
	var i;
	var fields;
	
	var PC = xfa.layout.pageCount();
	for (j=0; j &lt; PC; j++) {
		fields = xfa.layout.pageContent( j , "field", 0);
		for (i=0; i &lt;= fields.length-1; i++) {
			//console.println("parent.name : " + fields.item(i).parent.name);
			
			//skip button fields
			//skip floating fields (field.id.length != 0 mean a floating field
			//skip field with the name "plus"
			//Skip Main subform as all fields here are required.
			if ((fields.item(i).ui.oneOfChild.className != "button") &amp;&amp;
				( fields.item(i).id.length == 0 ) &amp;&amp;
				 ( fields.item(i).somExpression.indexOf("hidden") == -1 ) &amp;&amp;
					( fields.item(i).name != "plus") &amp;&amp;	
						( fields.item(i).access == "open") &amp;&amp;	
							( fields.item(i).name != "country") &amp;&amp;							
								( fields.item(i).somExpression.indexOf("Main") == -1 ) ) {
				
				
				nameStr = fields.item(i).name;
				nameStr = nameStr.substring(0,3);
				
				//skip ERR fields and skip field in the subtop subforms
				if (nameStr != "err") {
					//console.println("Field : " + fields.item(i).somExpression + " -- " +  fields.item(i).ui.oneOfChild.className );   
       				if ( !modus_utils.is_empty( fields.item(i) ) ) {
       					//console.println("Field : " + fields.item(i).somExpression + " -- " +  fields.item(i).ui.oneOfChild.className );   
						return false;  //form is NOT blank
					}
				}

			}			
			
 		}
	}
	
	
	return true;   //form is blank

}

/*
function verifyArray( inArray) {
	//check if incoming array has blank fields
	for(i=0;i&lt;inArray.length;i++) {
		
		fld = xfa.resolveNode(inArray[i]);
		//console.println("fld : " + fld.somExpression ) ;  
		//validate the field
		if ( !modus_utils.is_empty( fld ) ) {
			return false;  //form is NOT blank
		}
	}
	
	return true;   //form is blank
}
*/

function checkAddress (inSF, overseasFld ) { 
	var errCnt = 0;
	
	if (overseasFld.rawValue == "1") {
 		//foreign
 		errCnt += modus_utils.checkObj( inSF.foreign.add1, false, false);
 		errCnt += modus_utils.checkObj( inSF.foreign.country, false, false);
 	} else {
 		
 		if (inSF.local.privySF.presence == "visible") {
 			errCnt += modus_utils.checkObj(inSF.local.privySF.addType, false, false);
 			errCnt += modus_utils.checkObj(inSF.local.privySF.privy, false, false);
 			errCnt += modus_local.checkSGpostal( inSF.local.privySF.postcode);
 		} else if (inSF.local.landedSF.presence == "visible") {
 			errCnt += checkLocalPart(inSF.local.landedSF);
 		} else {
 			errCnt += checkLocalPart(inSF.local.buildingSF );
 		}
 		
 	}	

	return errCnt;

	//private function to checkAddress 
	function checkLocalPart(inSF) {
		var errCnt = 0;
		errCnt += modus_utils.checkObj(inSF.addType, false, false);
		errCnt += modus_utils.checkObj(inSF.block, false, false);
		errCnt += modus_utils.checkObj(inSF.street2, false, false);
		
		if (inSF.addType.rawValue == "2")  {
			//bulding
			errCnt += modus_utils.checkObj(inSF.storey, false, false);
			errCnt += modus_utils.checkObj(inSF.unit, false, false);
		} 
		
		errCnt += modus_local.checkSGpostal( inSF.postcode);
		
		return errCnt;
	}
}
</script><script contentType="application/x-javascript" name="modus_print">
			
//===========================
//reset borders of all the fields
function removeBorderSF (inSF) {
	//console.println( " ==&gt; " + inSF.somExpression ) ;
	
	//this will look for all child fields in this subform and will remove the red border 
	
	try {
		var allNodes = inSF.nodes;
		for (var i = 0; i &lt; allNodes.length ; i++) {
			//console.println( allNodes.item(i).ui.oneOfChild.className );
			if (allNodes.item(i).className == "field" ) {
				//console.println( allNodes.item(i).somExpression) ;
				processField( allNodes.item(i) );	
			} else if (allNodes.item(i).className == "exclGroup" ) {
				//console.println( allNodes.item(i).somExpression) ;
				modus_utils.removeRadioGroupColorRed ( allNodes.item(i)  );
			} else if ( allNodes.item(i).className == "subform" )  {
				//console.println( allNodes.item(i).somExpression ) ;
				//console.println( allNodes.item(i).layout  ) ;
				
				//remove border from "date" date subfiorms
				if ( allNodes.item(i).name.substring(0,4) == "date") {	
					//special case for date fields
					modus_utils.removeBorderColor(allNodes.item(i), false);
				}
				removeBorderSF ( allNodes.item(i) ) ;  //  recursive call to run all the fields of this child subform/radio group
			}
			
			
		}
	} catch(e) {
		var vDebug = "lockLetter()\n"; 
    	for (var prop in e) 
    	{  
       		vDebug += "property: "+ prop+ " value: ["+ e[prop]+ "]\n"; 
       	} 
    	vDebug += "toString(): " + " value: [" + e.toString() + "]"; 
		console.println(vDebug);
		//console.println(e.message);
	}
	
	function processField( inFld ) {
		//this will actual call the function to move the broder color.
		var nameStr;
		var node;
			//id.field length != 0 indicate a floating field.
		if ((inFld.ui.oneOfChild.className != "button") &amp;&amp;
			(inFld.ui.oneOfChild.className != "imageEdit") &amp;&amp;
			( inFld.id.length == 0 ) ) {
			
			nameStr = inFld.name;
			nameStr = nameStr.substring(0,3);
			
			//skip err_ fields 
			if (nameStr != "err") {
				//console.println("Field : " + inFld.somExpression + " -- " +  inFld.ui.oneOfChild.className );   
				
       			if ( inFld.parent.className == "exclGroup" ) {
       				//console.println("Field exclGroup : " + inFld.somExpression + " -- " +  inFld.ui.oneOfChild.className );   
					modus_utils.removeRadioGroupColorRed ( inFld.parent );
				} else if (inFld.ui.oneOfChild.className == "checkButton") {
					modus_utils.removeCheckBoxColorRed ( inFld);
				} else {
					//console.println(inFld.somExpression + " - " +  inFld.parent.layout );
					if ( inFld.parent.layout == "row" ) {
						//field in a table row	
						modus_utils.removeBorderColor( inFld, true);
					} else {
						node = inFld.resolveNode("ui.#textEdit");
						
						if (node != null &amp;&amp; node.multiLine == "1") {
							//console.println("processField name:" + inFld.somExpression + "  node.multiLine:" +  node.multiLine);
							modus_utils.removeBorderColor( inFld, true);
						} else {
							//console.println("processField name:" + inFld.somExpression);
							modus_utils.removeBorderColor( inFld, false);
						}
					}
				}	
 	
			}

		}
	
	}
}


</script><script contentType="application/x-javascript" name="modus_color">
function changeFontColor (fld, accessMode) {
	
	var colCode;
	if (accessMode == "open") {
		colCode = modus_utils.BORDER_EDGE_BLACK_COLOR ;
	} else {
		colCode =  modus_utils.BORDER_EDGE_GRAY_COLOR;
	}
	
	if(fld.className == "draw") {
		//static object, in use for text fields
		fld.font.fill.color.value = colCode;
	} else if (fld.className == "exclGroup") {
		//radio group, loop all options 
		modus_utils.removeRadioGroupColorRed ( fld );
		if (accessMode == "protected") {fld.rawValue = ""}
		fld.access = accessMode;
		var oNodes = fld.nodes;
		for (var i=0; i &lt; oNodes.length; i++) {
  			if (oNodes.item(i).className == "field") {
  				oNodes.item(i).caption.font.fill.color.value = colCode;
  				if (accessMode == "open") {
					oNodes.item(i).ui.checkButton.border.edge.color.value = modus_utils.BORDER_EDGE_GRAY_COLOR ;
				} else {
					oNodes.item(i).ui.checkButton.border.edge.color.value = colCode  ;
				}
				 
    		}
  		}
		
	} else {
		if (accessMode == "protected") {fld.rawValue = ""};
		if( fld.ui.oneOfChild.className == "checkButton") {
			fld.access = accessMode;
			modus_utils.removeCheckBoxColorRed ( fld );
			fld.caption.font.fill.color.value = colCode;
  			if (accessMode == "open") {
				fld.ui.checkButton.border.edge.color.value = modus_utils.BORDER_EDGE_GRAY_COLOR ;
			} else {
				fld.ui.checkButton.border.edge.color.value = colCode  ;
			}
		} else {
			//text, decimal, number, date fields
			fld.access = accessMode;
			modus_utils.removeBorderColor( fld );
			fld.caption.font.fill.color.value = colCode;
			fld.font.fill.color.value = colCode;
		} 
	}

}
  
 /* function setPrimary ( inSF ) {
  	if (inSF.selected.rawValue == "1") {
  		changeFontColor ( inSF.orgID , "open" );
  		changeFontColor (  inSF.lblorgID, "open" );
  	} else {
  		changeFontColor ( inSF.orgID , "protected" );
  		changeFontColor (  inSF.lblorgID, "protected" );
  	}
  }*/
  function setVelociy( inSF ) {
  	if ((inSF.velocity.rawValue == "1") || (inSF.velocity.rawValue == "2")) {
  		changeFontColor ( inSF.orgID , "open" ); 
  		changeFontColor ( inSF.lblorgID, "open" ); 
  		changeFontColor ( inSF.lblUser , "open" ); 
  		changeFontColor ( inSF.user, "open" ); 
  	} else {
  		changeFontColor ( inSF.orgID , "protected" );
  		changeFontColor ( inSF.lblorgID, "protected" );
  		changeFontColor ( inSF.lblUser , "protected" ); 
  		changeFontColor ( inSF.user, "protected" ); 
  	}
  }  
  
  function setVelociyUpdate( inFld, mode ) {
  	 changeFontColor ( inFld , mode );
  	 changeFontColor ( inFld.parent.parent.lblUpdate, mode );
  }
  
  function setEalert( inSF ) {
  	
  	if ((inSF.ealert.rawValue == "1") || (inSF.ealert.rawValue == "2")) {
  		changeFontColor ( inSF.userEalert, "open" );   
  		changeFontColor ( inSF.lblUserEalert, "open" );
  	} else {
  		changeFontColor ( inSF.userEalert, "protected" );
  		changeFontColor (  inSF.lblUserEalert, "protected" );
  	}
  }
  
  function setEalertUpdate( inFld, mode ) {
  	 changeFontColor ( inFld , mode );
  	 changeFontColor ( inFld.parent.parent.lblealertUpdate , mode );
  	 
  }

 function setTerminate( ) {
 	if (updEalerts.termination.dtls.termEalerts.rawValue == "1") {
 		changeFontColor (  updEalerts.termination.dtls.updateOptions, "open" );
 	} else {
 		changeFontColor (  updEalerts.termination.dtls.updateOptions, "protected" );
 	}
 }
 
  function colorStorey( mode , fld ) {
  	
  	changeFontColor ( fld, mode );
  	changeFontColor ( fld.parent.lblStorey , mode);
	
  }
  
    
  function colorUnit( mode , fld ) {
  
  	changeFontColor ( fld, mode );
  	changeFontColor (fld.parent.lblUnit , mode);
  	
    }


 function colorUserAccount( inSf, mode ) {
 //	console.println("colorUserAccount: " + mode + "-" + inSf.somExpression);
 	changeFontColor (inSf.recType , mode);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.userAccount.recType.user
 }
 
 function colorAccDetails(  inSf , mode ) {
 	//console.println("colorAccDetails: " + mode + "-" + inSf.somExpression);
 	changeFontColor (inSf.sfLeft.cash, mode);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.cash
 	changeFontColor (inSf.sfLeft.eAlert.trade, mode);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.eAlert.trade }
 }
 
 function colorAccount( inSf, mode ) {
 	//console.println("colorAccount: " + mode + "-" + inSf.somExpression);
 	changeFontColor  (inSf.lbl, mode); 
 	changeFontColor (inSf.ocbcAcc, mode);  //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.cashDetails.ocbcAcc
 }
 
 function colorCash( inSf, mode ) {
 	//console.println("colorCash: " + mode + "-" + inSf.somExpression);
 	changeFontColor (inSf.options.lang, mode);  //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.cashDetails.options.lang.en }
 	changeFontColor (inSf.options.via, mode);  //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfLeft.cashDetails.options.via.email }
 }
 
 
 function colorFunds( inSf, mode ){
 //	console.println("colorFunds: " + mode + "-" + inSf.somExpression);
 	changeFontColor (inSf.lbl, mode);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfRight.lbl
 	changeFontColor (inSf.amount, mode);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.accDetails.sfRight.amount.t200
 }
 
 function colorOptFeatures( inSf, mode ){
 	//console.println("colorOptFeatures: " + mode + "-" + inSf.somExpression);
 	changeFontColor (inSf.lbl, mode);   
 	changeFontColor (inSf.alert, mode);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.optFeature.alert
 	changeFontColor (inSf.timeDeposit, mode);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.optFeature.timeDeposit
 	if (mode == "open" &amp;&amp; inSf.timeDeposit.rawValue == "1") {
 		changeFontColor (inSf.ocbcAcc , mode);   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.optFeature.ocbcAcc 
 	} else {
 		changeFontColor (inSf.ocbcAcc , "protected");   //updEalerts.userDtls.dtls.sfUsers.sfeAlert.dtls.optFeature.ocbcAcc 
 	}
 }
