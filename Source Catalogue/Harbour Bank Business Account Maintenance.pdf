e="2.8222mm" mark="check"><border><edge thickness="0.25mm"><color value="102,102,102"/></edge><corner thickness="0.25mm"><color value="102,102,102"/></corner><fill/></border></checkButton></ui><font typeface="Myriad Pro"/><margin leftInset="0mm" rightInset="1mm"/><para vAlign="middle"/><value><integer>0</integer></value><caption reserve="15mm" placement="right"><para vAlign="middle"/><font typeface="Myriad Pro" size="8pt"/></caption><assist><speak disable="1"/></assist><items><text>1</text><text>0</text></items><bind match="dataRef" ref="$.dtlsContact.replaceAll"/><event activity="change" name="event__change"><script contentType="application/x-javascript">
 //var allNodes = xfa.resolveNodes("OCBC16.Main.business.contactDetails.dtls.contactP[*]");
 var node;
 var i;
 for (i=0;i&lt;_contactP.count;i++) {
 	node = xfa.resolveNode("contactP[" + i + "]");
 	if (this.rawValue == "1") {
 		//add/update becomes irrelevant
 		node.recOption.rawValue = "";
 		modus_utils.removeRadioGroupColorRed ( node.recOption );
 		node.recOption.presence = "invisible";
 		node.arrowrecOption.presence = "invisible";     // contactP.arrowrecOption
 		node.helpTick.presence = "invisible";    // contactP.helpTick
 		node.recOption.execInitialize();
 		node.options.addHead.presence = "visible";
 		//set autorised contect person
 		node.options.authContact.selected.rawValue = "1";
 		node.options.authContact.selected.access = "protected";
 		//node.options.primaryContact.presence = "visible";
 		//node.options.updateVelo.presence = "hidden";
 	} else {
 		node.recOption.presence = "visible";
 		node.arrowrecOption.presence = "visible";     // contactP.arrowrecOption
 		node.helpTick.presence = "visible";    // contactP.helpTick
 		node.recOption.execInitialize();
  		//node.options.primaryContact.presence = "hidden";
  		
  		//set autorised contact person
 		node.options.authContact.selected.rawValue = "0";
 		node.options.authContact.selected.access = "open";
 	}
 }
 
 
</script></event></field><draw name="lblIntro" w="170mm" minH="4.5mm" x="4mm" y="0.1mm"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="letter-spacing:0in">Tick to instruct bank to replace<span style="xfa-spacerun:yes">Â </span><span style="font-weight:bold">all<span style="xfa-spacerun:yes">Â </span></span><span style="font-weight:bold;text-decoration:underline">Authorised Contact Person</span><span style="font-weight:bold"> record(s) with the information below.</span></p></body></exData></value><ui><textEdit/></ui><para vAlign="middle" spaceAbove="0pt" spaceBelow="0pt" textIndent="0pt" marginLeft="0pt" marginRight="0pt" hAlign="justify"/><font size="8pt" typeface="Myriad Pro" baselineShift="0pt"><fill><color value="39,39,39"/></fill></font><assist><speak disable="1"/></assist><margin bottomInset="0mm" topInset="1mm"/></draw><bind match="none"/><border><edge presence="hidden"/><fill><color value="225,225,225"/></fill></border><?templateDesigner expand 0?></subform><subform w="179.5mm" name="contactP"><field name="no" y="2mm" x="0.001mm" w="62mm" h="9mm" id="floatingField008616" presence="hidden" access="readOnly"><ui><textEdit><border><edge stroke="lowered"/></border><margin/></textEdit></ui><font typeface="Myriad Pro"/><margin topInset="1mm" bottomInset="1mm" leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><bind match="none"/></field><draw x="0.001mm" h="7mm" y="2mm"><font typeface="Arial" size="8pt"><fill><color value="39,39,39"/></fill></font><para vAlign="middle"/><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="font-family:'Myriad Pro';font-size:11pt;font-weight:bold;letter-spacing:0in">Contact Person<span style="xfa-spacerun:yes">Â </span><span xfa:embedType="uri" xfa:embedMode="raw" xfa:embed="#floatingField008616"/></p></body></exData></value><ui><textEdit/></u