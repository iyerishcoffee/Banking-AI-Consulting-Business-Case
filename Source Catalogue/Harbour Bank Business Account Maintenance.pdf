 modus_utils.specialPrintBlank  = true;
 app.execMenuItem("Print");  
</script></event><assist><speak disable="1"/></assist></field></subform><draw name="verified" w="30mm" minH="14mm" y="0mm"><value><text>Verified/Authorised By/Date</text></value><ui><textEdit/></ui><font size="7pt" typeface="Myriad Pro" posture="italic"><fill><color value="128,128,128"/></fill></font><assist><speak disable="1"/></assist><border><edge><color value="128,128,128"/></edge><corner thickness="0.1778mm"><color value="128,128,128"/></corner></border><margin leftInset="1mm" topInset="1mm"/></draw><draw name="branch" w="1.181097in" minH="14mm" y="0mm"><value><text>Branch/Dept Name</text></value><ui><textEdit/></ui><font size="7pt" typeface="Myriad Pro" posture="italic"><fill><color value="128,128,128"/></fill></font><assist><speak disable="1"/></assist><border><edge><color value="128,128,128"/></edge><corner thickness="0.1778mm"><color value="128,128,128"/></corner></border><margin leftInset="1mm" topInset="1mm"/></draw><draw name="input" w="1.181097in" minH="14mm" y="0mm"><value><text>Input By/Date</text></value><ui><textEdit/></ui><font size="7pt" typeface="Myriad Pro" posture="italic"><fill><color value="128,128,128"/></fill></font><assist><speak disable="1"/></assist><border><edge><color value="128,128,128"/></edge><corner thickness="0.1778mm"><color value="128,128,128"/></corner></border><margin leftInset="1mm" topInset="1mm"/></draw><draw name="auth" w="1.161444in" minH="14mm" y="0mm"><value><text>Verified/Authorised By/Date</text></value><ui><textEdit/></ui><font size="7pt" typeface="Myriad Pro" posture="italic"><fill><color value="128,128,128"/></fill></font><assist><speak disable="1"/></assist><border><edge><color value="128,128,128"/></edge><corner thickness="0.1778mm"><color value="128,128,128"/></corner></border><margin leftInset="1mm" topInset="1mm"/></draw><border><edge presence="hidden"/></border><bind match="none"/><?templateDesigner expand 1?></subform><keep intact="contentArea"/><bind match="none"/><?templateDesigner rowpattern first:1, next:1, firstcolor:f0f0f0, nextcolor:ffffff, apply:0?><margin topInset="2mm"/><?templateDesigner expand 1?></subform><draw name="footnote" w="179.5mm" minH="1mm"><value><text>* Business unit to furnish industry code if customer has specified the new principal activity(ies)â€©** ACRA Business Profile is required (ACRA printout must be dated within 3 months)</text></value><ui><textEdit/></ui><font size="7pt" typeface="Myriad Pro" posture="italic"><fill><color value="128,128,128"/></fill></font><assist><speak disable="1"/></assist><border><edge presence="hidden"><color value="128,128,128"/></edge><corner thickness="0.1778mm" presence="hidden"><color value="128,128,128"/></corner></border><margin leftInset="1mm" topInset="1mm"/></draw><?templateDesigner expand 0?></subform><?templateDesigner expand 0?></subform><breakBefore targetType="pageArea" startNew="1" target="Page1"/><?templateDesigner expand 0?></subform><subform w="254mm" name="envelop" layout="tb" presence="hidden"><subform w="210mm" h="98mm" name="top"><draw name="title" x="8.795mm" y="16.545mm" w="57.784mm" minH="0.248in"><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="font-family:'Myriad Pro';text-decoration:none;letter-spacing:0in">What to do next?</p></body></exData></value><ui><textEdit/></ui><para vAlign="middle"/><font weight="bold" size="11pt" typeface="Myriad Pro"><fill><color value="39,39,39"/></fill></font></draw><draw name="box" y="28.545mm" x="9.295mm" w="192mm" h="16mm"><value><rectangle><edge stroke="dotted"/><corner stroke="dotted" radius="5.08mm"/></rectangle></value></draw><draw name="first" y="30.545mm" x="11.295mm" w="43mm" h="12mm"><ui><textEdit/></ui><value><text>Mail this form back to us or visit any Harbour Bank bank branch with your completed form</text></value><font size="8pt" typeface="Myriad Pro" weight="bold"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/><para vAlign="middle"/></draw><draw name="second" y="30.545mm" x="58.295mm" w="60mm" h="12mm"><ui><textEdit/></ui><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="font-weight:bold;letter-spacing:0in">Allow 7 working days for processing</p><p style="font-style:italic;letter-spacing:0in">(For enquiries, please contact support@harbourbank.example)</p></body></exData></value><font size="8pt" typeface="Myriad Pro"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/><para vAlign="middle"/></draw><draw name="third" y="30.545mm" x="122.295mm" w="77mm" h="12mm"><ui><textEdit/></ui><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="font-weight:bold;letter-spacing:0in">Confirmation letter will be mailed to you</p></body></exData></value><font size="8pt" typeface="Myriad Pro"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/><para vAlign="middle"/></draw><draw name="Line1" y="36.545mm" x="52.295mm" w="4mm" h="8mm"><value><line slope="/"><edge stroke="dotted"/></line></value></draw><draw name="Line2" y="28.545mm" x="52.295mm" w="4mm" h="8mm"><value><line><edge stroke="dotted"/></line></value></draw><draw name="Line3" y="36.545mm" x="116.295mm" w="4mm" h="8mm"><value><line slope="/"><edge stroke="dotted"/></line></value></draw><draw name="Line4" y="28.545mm" x="116.295mm" w="4mm" h="8mm"><value><line><edge stroke="dotted"/></line></value></draw><bind match="none"/><?templateDesigner expand 0?></subform><subform w="210mm" h="100mm" name="centre"><border><edge stroke="dotted"/><corner stroke="dotted" thickness="0.176mm"/><corner stroke="dotted" presence="hidden" thickness="0.176mm"/><corner stroke="dotted" thickness="0.176mm"/><corner stroke="dotted" presence="hidden" thickness="0.176mm"/><edge presence="hidden" stroke="dotted"/><edge stroke="dotted"/><edge presence="hidden" stroke="dotted"/></border><draw name="postage" x="176mm" w="30mm" h="30mm"><ui><textEdit/></ui><value><text>Postage will â€©be paid by addressee. â€©For posting in Singapore only</text></value><font typeface="Myriad Pro" size="12pt"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/><para hAlign="center" vAlign="middle"/><border><edge presence="hidden"/><edge presence="hidden"/><edge/><edge/><corner/></border></draw><draw name="right" y="30mm" x="191mm" w="3mm" h="70mm"><value><rectangle><edge presence="hidden"/><fill><color value="0,0,0"/></fill><corner radius="5.08mm" presence="hidden"/></rectangle></value></draw><draw name="left" y="30mm" x="185mm" w="3mm" h="70mm"><value><rectangle><edge presence="hidden"/><fill><color value="0,0,0"/></fill><corner radius="5.08mm" presence="hidden"/></rectangle></value></draw><draw name="brs" y="33mm" x="55mm" w="70mm" h="11mm"><ui><textEdit/></ui><value><text>BUSINESS REPLY SERVICEâ€©PERMIT NO. 08066</text></value><font size="12pt" typeface="Myriad Pro" weight="bold"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/><para hAlign="center" vAlign="middle"/><border><edge thickness="0.2mm"/><corner thickness="0.2mm"/></border></draw><field name="PostUKRM4SCCBarCode1" y="47mm" x="80.5mm" w="19mm" h="4.2mm" access="protected"><ui><barcode type="postUKRM4SCC" textLocation="none" dataLength="5" checksum="auto"/></ui><font typeface="Courier New"/><value><text>08066</text></value><bind match="none"/></field><draw name="address" y="56mm" x="45mm" w="90mm" h="25.694mm"><ui><textEdit/></ui><value><exData contentType="text/html"><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"><p style="font-weight:bold;text-decoration:none;letter-spacing:0in">HARBOUR BANK</p><p style="text-decoration:none;letter-spacing:0in">ACCOUNT SERVICES</p><p style="text-decoration:none;letter-spacing:0in">PRIVY BOX NO. 920340</p><p style="text-decoration:none;letter-spacing:0in">SINGAPORE 929292</p></body></exData></value><font typeface="Myriad Pro"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.5mm" rightInset="0.5mm"/><para hAlign="center"/></draw><bind match="none"/><?templateDesigner expand 0?></subform><subform w="210mm" h="99mm" name="bottom"><draw name="title" x="7.5mm" y="9mm" w="57.784mm" minH="0.248in"><value><text>Have You</text></value><ui><textEdit/></ui><para vAlign="middle"/><font weight="bold" typeface="Myriad Pro"><fill><color value="59,59,59"/></fill></font></draw><field name="CheckBox1" y="19mm" x="7.5mm" w="53.5mm" h="6mm" access="protected"><ui><checkButton><border><edge/><fill/></border></checkButton></ui><font typeface="Adobe Arabic"/><margin leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><value><integer>0</integer></value><caption placement="right" reserve="46.5mm"><para vAlign="middle"/><font size="8pt" typeface="Myriad Pro"><fill><color value="59,59,59"/></fill></font><value><text>filled in all the relevant fields?</text></value></caption><items><integer>1</integer><integer>0</integer><integer>2</integer></items><bind match="none"/></field><field name="CheckBox1" y="26mm" x="7.5mm" w="70.5mm" h="6mm" access="protected"><ui><checkButton><border><edge/><fill/></border></checkButton></ui><font typeface="Adobe Arabic"/><margin leftInset="1mm" rightInset="1mm"/><para vAlign="middle"/><value><integer>0</integer></value><caption placement="right" reserve="63.5mm"><para vAlign="middle"/><font size="8pt" typeface="Myriad Pro"><fill><color value="59,59,59"/></fill></font><value><text>signed against any alterations?</text></value></caption><items><integer>1</integer><integer>0</integer><integer>2</integer></items><bind match="none"/></field><draw x="7.5mm" y="54mm" w="190mm" h="13.982mm"><value><text>Please mail this completed form back to us. Thank you!</text></value><ui><textEdit/></ui><margin leftInset="0.5mm" rightInset="0.5mm" topI